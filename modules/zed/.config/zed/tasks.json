[
  {
    "label": "Maven: build",
    "command": "mvn",
    "args": ["clean", "compile"]
  },
  {
    "label": "Maven: test",
    "command": "mvn",
    "args": ["test"]
  },
  {
    "label": "Maven: test (current file)",
    "command": "mvn",
    "args": ["test", "-Dtest=$ZED_STEM"]
  },
  {
    "label": "Maven: package",
    "command": "mvn",
    "args": ["clean", "package", "-DskipTests"]
  },
  {
    "label": "Gradle: build",
    "command": "./gradlew",
    "args": ["build"]
  },
  {
    "label": "Gradle: test",
    "command": "./gradlew",
    "args": ["test"]
  },
  {
    "label": "Gradle: test (current file)",
    "command": "./gradlew",
    "args": ["test", "--tests", "$ZED_STEM"]
  },
  {
    "label": "mise: fmt",
    "command": "mise",
    "args": ["run", "fmt"]
  },
  {
    "label": "mise: lint",
    "command": "mise",
    "args": ["run", "lint"]
  },
  {
    "label": "mise: test",
    "command": "mise",
    "args": ["run", "test"]
  },
  {
    "label": "mise: up",
    "command": "mise",
    "args": ["run", "up"],
    "use_new_terminal": true
  },
  {
    "label": "mise: e2e",
    "command": "mise",
    "args": ["run", "e2e"]
  },
  {
    "label": "hurl: run current file",
    "command": "hurl",
    "args": ["--test", "--variable", "server=http://localhost:8080", "$ZED_FILE"]
  }
]
