[
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space t": "terminal_panel::ToggleFocus",
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "g d": "editor::GoToDefinition",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "K": "editor::Hover",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space f b": "tab_switcher::Toggle",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "alt-shift-h": "vim::ResizePaneLeft",
      "alt-shift-j": "vim::ResizePaneDown",
      "alt-shift-k": "vim::ResizePaneUp",
      "alt-shift-l": "vim::ResizePaneRight",
      "space /": "pane::DeploySearch",
      "space s g": "pane::DeploySearch",
      "space s d": "diagnostics::Deploy",
      "space x x": "diagnostics::Deploy",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space |": "pane::SplitRight",
      "space -": "pane::SplitDown",
      "space u w": "editor::ToggleSoftWrap",
      "space u h": "editor::ToggleInlayHints",
      "space u d": "editor::ToggleDiagnostics",
      "space u v": "editor::ToggleInlineDiagnostics",
      "space u b": "theme::ToggleMode",
      "space u z": "workspace::ToggleCenteredLayout",
      "space q q": "zed::Quit",
      "space d b": "editor::ToggleBreakpoint",
      "space d a": "debugger::Start",
      "space d c": "debugger::Continue",
      "space d o": "debugger::StepOver",
      "space d i": "debugger::StepInto",
      "space d shift-o": "debugger::StepOut",
      "space d t": "debugger::Stop",
      "space j j": ["task::Spawn", { "task_name": "jjui", "reveal_target": "center" }],
      "space j n": ["task::Spawn", { "task_name": "jj: new" }],
      "space j f": ["task::Spawn", { "task_name": "jj: fetch" }],
      "space j p": ["task::Spawn", { "task_name": "jj: push" }]
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": ["terminal::SendKeystroke", "ctrl-h"],
      "ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
      "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"]
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::HelixJumpToWord"
    }
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual) && !VimCount && !menu",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::SwitchToNormalMode"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-h": "workspace::ToggleLeftDock"
    }
  }
]
