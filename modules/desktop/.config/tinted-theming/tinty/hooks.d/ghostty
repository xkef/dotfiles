#!/usr/bin/env fish
# tinty hook: points ~/.config/ghostty/theme, which the Ghostty config
# includes, at tinty's current_scheme, then reloads running Ghostty
# instances. Ghostty reloads its config on SIGUSR2. Without a Ghostty
# config the hook does nothing.
#
# A scheme in builtin uses Ghostty's copy of the theme's official palette,
# as wezterm/colors.lua does for WezTerm, so both terminals match. Every
# other scheme links the tinted-terminal Ghostty file.

set -l config_dir ~/.config/ghostty
test -f $config_dir/config; or exit 0

set -l data_home ~/.local/share
set -q XDG_DATA_HOME; and set data_home $XDG_DATA_HOME
set -l tinty $data_home/tinted-theming/tinty

# tinty scheme names, without the base16- or base24- prefix, and the
# built-in Ghostty themes they map to. Ghostty lacks some everforest
# variants of colors.lua, so those keep the tinted-terminal file.
set -l builtin \
    catppuccin-latte "Catppuccin Latte" \
    catppuccin-frappe "Catppuccin Frappe" \
    catppuccin-macchiato "Catppuccin Macchiato" \
    catppuccin-mocha "Catppuccin Mocha" \
    tokyo-night-dark "TokyoNight Night" \
    tokyo-night-storm "TokyoNight Storm" \
    tokyo-night-moon "TokyoNight Moon" \
    tokyo-night-light "TokyoNight Day" \
    rose-pine "Rose Pine" \
    rose-pine-moon "Rose Pine Moon" \
    rose-pine-dawn "Rose Pine Dawn" \
    kanagawa "Kanagawa Wave" \
    kanagawa-dragon "Kanagawa Dragon" \
    everforest-dark-hard "Everforest Dark Hard" \
    everforest-light-medium "Everforest Light Med"

read -l scheme <$tinty/current_scheme; or exit 0
set -l name (string replace -r '^base\d+-' '' -- $scheme)
set -l index (contains -i -- $name $builtin[(seq 1 2 (count $builtin))])

# The theme file may be a link into the tinted-terminal repo, so it is
# removed before a write, which would follow the link.
if set -q index[1]
    set -l theme $builtin[(math 2 \* $index)]
    rm -f $config_dir/theme
    echo "theme = $theme" >$config_dir/theme
else
    set -l theme_file $tinty/repos/tinted-terminal/themes/ghostty/$scheme
    test -f $theme_file; or exit 0
    ln -sf $theme_file $config_dir/theme
end
pkill -USR2 -x ghostty; or true
