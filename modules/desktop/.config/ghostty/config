# https://ghostty.org/docs/config

# ── Font ──────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 14
font-feature = calt
adjust-cell-height = 20%
minimum-contrast = 1.1

# ── Input ─────────────────────────────────────────────
# Left Option sends Alt for the shell and tv bindings. Right Option still
# types special characters such as @, [], and {}.
macos-option-as-alt = left

# ── Theme ─────────────────────────────────────────────
# Tracked default only. `theme` switches schemes through tinty, whose
# ghostty hook writes the untracked ./theme, a link to the scheme's
# tinted-terminal file or a `theme =` line for a built-in scheme, and
# reloads Ghostty. The optional include loads after this file, so it wins.
# The path is absolute because this file is a link into the dotfiles repo.
theme = Catppuccin Frappe
config-file = ?~/.config/ghostty/theme

# ── Window ────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 0
window-padding-balance = true
window-decoration = true
macos-titlebar-style = hidden
window-theme = ghostty
unfocused-split-opacity = 0.9
confirm-close-surface = false

# ── Cursor ────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
shell-integration-features = cursor,sudo,title,ssh-env

# ── Clipboard ────────────────────────────────────────
clipboard-read = allow
copy-on-select = clipboard

# ── Mouse ─────────────────────────────────────────────
mouse-hide-while-typing = true

# ── Terminal ──────────────────────────────────────────
scrollback-limit = 50000

# ── Keybindings ───────────────────────────────────────
# The macOS cmd bindings stay built in. These add the Linux ctrl+shift
# equivalents on every platform.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
keybind = ctrl+shift+f=toggle_fullscreen

# ── Quick terminal ─────────────────────────────────
quick-terminal-size = 50%
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# ── State ─────────────────────────────────────────
window-save-state = always
