{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "allow_launch_services": true,
  "diagnostics": {
    "suppress_system_services": [
      "forbidden-exec-sugid"
    ]
  },
  "extends": "agents",
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$XDG_CONFIG_HOME/claude-code",
      "$HOME/.local/state/claude/locks",
      "$HOME/.cache/claude",
      "$HOME/.config/nono/profile-drafts",
      "/tmp/claude-$UID"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock"
    ],
    "read": [
      "$XDG_CONFIG_HOME/fd",
      "$HOME/.terminfo",
      "$XDG_CONFIG_HOME/lazyvim",
      "$XDG_DATA_HOME/lazyvim"
    ]
  },
  "groups": {
    "include": [
      {
        "name": "claude_code_macos",
        "when": "macos"
      },
      {
        "name": "claude_code_linux",
        "when": "linux"
      },
      {
        "name": "claude_cache_linux",
        "when": "linux"
      },
      "rust_runtime",
      "python_runtime",
      {
        "name": "vscode_macos",
        "when": "macos"
      },
      {
        "name": "vscode_linux",
        "when": "linux"
      },
      {
        "name": "linux_sysfs_read",
        "when": "linux"
      },
      "nix_runtime"
    ]
  },
  "meta": {
    "description": "Claude Code for an unfamiliar repository: the claude profile without the gh config or the 1Password SSH agent",
    "name": "claude-strict",
    "version": "1.1.0"
  },
  "network": {
    "block": false
  },
  "open_urls": {
    "allow_localhost": true,
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://api.anthropic.com",
      "https://platform.claude.com"
    ]
  },
  "rollback": {
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9]*"
    ],
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target"
    ]
  },
  "security": {
    "capability_elevation": false,
    "signal_mode": "isolated"
  }
}
