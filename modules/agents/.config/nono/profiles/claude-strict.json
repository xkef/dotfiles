{
  "$schema": "https://nono.dev/schemas/nono-profile.schema.json",
  "allow_launch_services": true,
  "diagnostics": {
    "suppress_system_services": [
      "forbidden-exec-sugid"
    ]
  },
  "extends": "default",
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$XDG_CONFIG_HOME/claude-code",
      "$HOME/.local/state/claude/locks",
      "$HOME/.cache/claude",
      "$HOME/.config/nono/profile-drafts",
      "/tmp/claude-$UID",
      "$XDG_STATE_HOME/agents",
      "$HOME/.m2/repository",
      "$HOME/.npm",
      "$XDG_CACHE_HOME/mise",
      "$XDG_CACHE_HOME/uv",
      "$XDG_DATA_HOME/cargo/registry",
      "$XDG_DATA_HOME/cargo/git",
      "$XDG_DATA_HOME/go/pkg/mod"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock",
      "$XDG_DATA_HOME/cargo/.package-cache",
      "$XDG_DATA_HOME/cargo/.package-cache-mutate",
      "$XDG_DATA_HOME/cargo/.global-cache"
    ],
    "read": [
      "$HOME/.agents",
      "$HOME/.m2",
      "$XDG_CONFIG_HOME/jj",
      "$XDG_DATA_HOME/cargo",
      "$XDG_DATA_HOME/rustup",
      "$XDG_DATA_HOME/go",
      "$XDG_DATA_HOME/mise",
      "$XDG_DATA_HOME/uv",
      "$XDG_STATE_HOME/mise",
      "$XDG_CONFIG_HOME/git",
      "$XDG_DATA_HOME/tinted-theming/tinty",
      "$XDG_CONFIG_HOME/nono/profiles",
      "$XDG_CONFIG_HOME/nono/packages",
      "$XDG_CONFIG_HOME/fd",
      "$HOME/.terminfo",
      "$XDG_CONFIG_HOME/lazyvim",
      "$XDG_DATA_HOME/lazyvim",
      {
        "path": "$HOME/.local/share/claude",
        "when": "macos"
      },
      {
        "path": "$HOME/Applications/Claude Code URL Handler.app",
        "when": "macos"
      }
    ]
  },
  "groups": {
    "include": [
      "git_config",
      "mise_manager",
      "node_runtime",
      {
        "name": "user_caches_macos",
        "when": "macos"
      },
      "unlink_protection",
      {
        "name": "claude_code_linux",
        "when": "linux"
      },
      {
        "name": "claude_cache_linux",
        "when": "linux"
      },
      "rust_runtime",
      "python_runtime",
      {
        "name": "vscode_macos",
        "when": "macos"
      },
      {
        "name": "vscode_linux",
        "when": "linux"
      },
      {
        "name": "linux_sysfs_read",
        "when": "linux"
      },
      "nix_runtime"
    ]
  },
  "meta": {
    "description": "Claude Code for an unfamiliar repository: no GitHub token, SSH agent, or keychain, and outbound traffic limited to the claude-code allowlist",
    "name": "claude-strict",
    "version": "2.0.0"
  },
  "network": {
    "block": false,
    "network_profile": "claude-code"
  },
  "open_urls": {
    "allow_localhost": true,
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://api.anthropic.com",
      "https://platform.claude.com"
    ]
  },
  "rollback": {
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9]*"
    ],
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target"
    ]
  },
  "security": {
    "capability_elevation": false,
    "signal_mode": "isolated"
  },
  "workdir": {
    "access": "readwrite"
  }
}
