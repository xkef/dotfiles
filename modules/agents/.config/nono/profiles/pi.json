{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "extends": "agents",
  "filesystem": {
    "allow": [
      "$HOME/.pi"
    ]
  },
  "meta": {
    "description": "pi.dev coding agent with mise, node, jj, maven, npm, cargo, and shared skills. Its OpenRouter key comes from the credential proxy",
    "name": "pi",
    "version": "2.0.0"
  },
  "network": {
    "credentials": ["openrouter"],
    "custom_credentials": {
      "openrouter": {
        "upstream": "https://openrouter.ai",
        "credential_key": "openrouter_api_key",
        "env_var": "OPENROUTER_API_KEY",
        "credential_format": "Bearer {}"
      }
    }
  }
}
