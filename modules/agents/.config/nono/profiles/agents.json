{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "credential_capture": {
    "github": {
      "command": ["gh", "auth", "token"],
      "cache_ttl_secs": 900
    },
    "github_git": {
      "command": [
        "/bin/sh",
        "-c",
        "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; printf 'x-access-token:%s' \"$(gh auth token)\""
      ],
      "cache_ttl_secs": 900
    }
  },
  "environment": {
    "case_insensitive_vars": true,
    "deny_vars": [
      "*_TOKEN",
      "*_TOKEN_*",
      "*_SECRET",
      "*_SECRET_*",
      "*_PASSWORD",
      "*_PASSWD",
      "*_CREDENTIAL",
      "*_CREDENTIALS",
      "*_API_KEY",
      "*_APIKEY",
      "*_ACCESS_KEY",
      "*_PRIVATE_KEY"
    ]
  },
  "extends": "default",
  "filesystem": {
    "allow": [
      "$HOME/.agents",
      "$XDG_STATE_HOME/agents",
      "$HOME/.m2",
      "$HOME/.npm",
      "$XDG_CACHE_HOME/mise",
      "$XDG_CACHE_HOME/uv",
      "$XDG_CONFIG_HOME/jj/repos",
      "$XDG_DATA_HOME/cargo/registry",
      "$XDG_DATA_HOME/cargo/git",
      "$XDG_DATA_HOME/rustup",
      "$XDG_DATA_HOME/go",
      "$XDG_DATA_HOME/uv"
    ],
    "allow_file": [
      "$XDG_DATA_HOME/cargo/.global-cache",
      "$XDG_DATA_HOME/cargo/.package-cache",
      "$XDG_DATA_HOME/cargo/.package-cache-mutate"
    ],
    "bypass_protection": [
      "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
      "$HOME/.1password/agent.sock"
    ],
    "read": [
      "$XDG_DATA_HOME/cargo/bin",
      "$XDG_DATA_HOME/mise",
      "$XDG_STATE_HOME/mise",
      "$XDG_CONFIG_HOME/gh",
      "$XDG_CONFIG_HOME/git",
      "$XDG_CONFIG_HOME/jj",
      "$XDG_DATA_HOME/tinted-theming/tinty",
      "$XDG_CONFIG_HOME/nono/profiles"
    ],
    "unix_socket": [
      "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
      "$HOME/.1password/agent.sock"
    ]
  },
  "groups": {
    "include": [
      "git_config",
      "mise_manager",
      "node_runtime",
      {
        "name": "user_caches_macos",
        "when": "macos"
      },
      "unlink_protection"
    ]
  },
  "meta": {
    "description": "Base of the claude and pi profiles: shared skills, agent state, toolchains, the 1Password SSH agent for commit signing, and GitHub through the credential proxy. jj may write only its per-repository state, since jj outside the sandbox runs its config",
    "name": "agents",
    "version": "2.0.0"
  },
  "network": {
    "block": false,
    "credentials": ["github", "github_git"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}"
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "cmd://github_git",
        "env_var": "GITHUB_GIT_TOKEN",
        "inject_mode": "basic_auth"
      }
    }
  },
  "workdir": {
    "access": "readwrite"
  }
}
