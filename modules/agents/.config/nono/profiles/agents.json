{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "credential_capture": {
    "github": {
      "command": [
        "/bin/sh",
        "-c",
        "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; security find-generic-password -s nono -a \"github-$(git config --get github.user || gh config get -h github.com user)\" -w"
      ],
      "cache_ttl_secs": 900,
      "timeout_secs": 60
    },
    "github_git": {
      "command": [
        "/bin/sh",
        "-c",
        "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; printf 'x-access-token:%s' \"$(security find-generic-password -s nono -a \"github-$(git config --get github.user || gh config get -h github.com user)\" -w)\""
      ],
      "cache_ttl_secs": 900,
      "timeout_secs": 60
    }
  },
  "environment": {
    "case_insensitive_vars": true,
    "deny_vars": [
      "*_TOKEN",
      "*_TOKEN_*",
      "*_SECRET",
      "*_SECRET_*",
      "*_PASSWORD",
      "*_PASSWD",
      "*_CREDENTIAL",
      "*_CREDENTIALS",
      "*_API_KEY",
      "*_APIKEY",
      "*_ACCESS_KEY",
      "*_PRIVATE_KEY"
    ],
    "set_vars": {
      "CARGO_HOME": "$XDG_CACHE_HOME/agents-sandbox/cargo",
      "RUSTUP_HOME": "$XDG_CACHE_HOME/agents-sandbox/rustup",
      "GOPATH": "$XDG_CACHE_HOME/agents-sandbox/go",
      "GOBIN": "$XDG_CACHE_HOME/agents-sandbox/go/bin",
      "GOCACHE": "$XDG_CACHE_HOME/agents-sandbox/go-build",
      "UV_CACHE_DIR": "$XDG_CACHE_HOME/agents-sandbox/uv/cache",
      "UV_PYTHON_INSTALL_DIR": "$XDG_CACHE_HOME/agents-sandbox/uv/python",
      "UV_TOOL_DIR": "$XDG_CACHE_HOME/agents-sandbox/uv/tools",
      "UV_TOOL_BIN_DIR": "$XDG_CACHE_HOME/agents-sandbox/uv/bin",
      "npm_config_cache": "$XDG_CACHE_HOME/agents-sandbox/npm",
      "MAVEN_USER_HOME": "$XDG_CACHE_HOME/agents-sandbox/m2",
      "MAVEN_OPTS": "-Dmaven.repo.local=$XDG_CACHE_HOME/agents-sandbox/m2/repository",
      "GIT_CONFIG_COUNT": "1",
      "GIT_CONFIG_KEY_0": "credential.helper",
      "GIT_CONFIG_VALUE_0": ""
    }
  },
  "extends": "default",
  "filesystem": {
    "allow": [
      "$HOME/.agents",
      "$XDG_STATE_HOME/agents",
      "$XDG_CACHE_HOME/agents-sandbox",
      "$XDG_CACHE_HOME/mise"
    ],
    "bypass_protection": [
      "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
      "$HOME/.1password/agent.sock"
    ],
    "read": [
      "$XDG_DATA_HOME/cargo/bin",
      "$XDG_DATA_HOME/mise",
      "$XDG_STATE_HOME/mise",
      "$XDG_CONFIG_HOME/gh",
      "$XDG_CONFIG_HOME/git",
      "$XDG_CONFIG_HOME/jj",
      "$XDG_CONFIG_HOME/jj/repos",
      "$XDG_DATA_HOME/tinted-theming/tinty",
      "$XDG_CONFIG_HOME/nono/profiles",
      "$HOME/.m2/settings.xml"
    ],
    "unix_socket": [
      "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
      "$HOME/.1password/agent.sock"
    ]
  },
  "groups": {
    "include": [
      "git_config",
      "mise_manager",
      "node_runtime",
      "unlink_protection"
    ]
  },
  "meta": {
    "description": "Base of the claude and pi profiles: shared skills, agent state, the 1Password SSH agent for commit signing, and GitHub through the credential proxy. Toolchains, their caches, and the Maven repository live in a sandbox-only home, and jj's per-repository config stays read-only, since the host runs what both hold",
    "name": "agents",
    "version": "2.0.0"
  },
  "network": {
    "block": false,
    "credentials": ["github", "github_git"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}"
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "cmd://github_git",
        "env_var": "GITHUB_GIT_TOKEN",
        "inject_mode": "basic_auth"
      }
    }
  },
  "workdir": {
    "access": "readwrite"
  }
}
