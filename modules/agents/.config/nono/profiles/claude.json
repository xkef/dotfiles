{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "diagnostics": {
    "suppress_system_services": [
      "forbidden-exec-sugid"
    ]
  },
  "extends": "agents",
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$XDG_CONFIG_HOME/claude-code",
      "$HOME/.local/state/claude/locks",
      "$HOME/.cache/claude",
      "$HOME/.config/nono/profile-drafts",
      "/tmp/claude-$UID"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock"
    ],
    "read": [
      "$HOME/.local/share/claude",
      "$XDG_CONFIG_HOME/fd",
      "$HOME/.terminfo",
      "$XDG_CONFIG_HOME/lazyvim",
      "$XDG_DATA_HOME/lazyvim"
    ]
  },
  "groups": {
    "include": [
      {
        "name": "claude_code_linux",
        "when": "linux"
      },
      {
        "name": "claude_cache_linux",
        "when": "linux"
      },
      "rust_runtime",
      "python_runtime",
      {
        "name": "linux_sysfs_read",
        "when": "linux"
      },
      "nix_runtime"
    ]
  },
  "meta": {
    "description": "Claude Code with mise, jj, maven, npm, cargo, and shared skills. Its login comes from the credential proxy, and the keychain stays denied",
    "name": "claude",
    "version": "2.0.0"
  },
  "network": {
    "credentials": ["claude"],
    "custom_credentials": {
      "claude": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "claude_code_oauth_token",
        "env_var": "CLAUDE_CODE_OAUTH_TOKEN",
        "credential_format": "Bearer {}"
      }
    }
  },
  "open_urls": {
    "allow_localhost": true,
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://api.anthropic.com",
      "https://platform.claude.com"
    ]
  },
  "platform_overrides": {
    "macos": {
      "filesystem": {
        "allow": [
          "$HOME/Library/Caches/claude-cli-nodejs"
        ]
      }
    }
  },
  "rollback": {
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9a-f]*"
    ],
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target"
    ]
  },
  "security": {
    "capability_elevation": false,
    "signal_mode": "isolated"
  }
}
