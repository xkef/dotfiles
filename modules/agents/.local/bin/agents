#!/usr/bin/env fish
# agents: coding agent tools, a thin dispatcher over the agent-* scripts
# and lima-agent. `dots` manages the dotfiles and knows nothing of these.
#
# Usage: agents <command> [args]

switch $argv[1]
    case skills
        # @key agents :: skills :: Refresh shared agent skills from upstream
        agent-skills $argv[2..-1]
    case trace
        # @key agents :: trace :: Report failed tool calls in Claude Code sessions
        agent-trace $argv[2..-1]
    case vm
        # @key agents :: vm :: Claude Code or a shell on a repository copy in the Lima VM
        lima-agent $argv[2..-1]
    case help -h --help ''
        echo "Usage: agents <command>"
        echo ""
        echo "Commands:"
        # Each command's @key line, which dots-ref lists too.
        awk -F ' :: ' '/^ *# @key agents :: / { printf "  %-9s %s\n", $2, $3 }' (status filename)
        echo ""
    case '*'
        echo "Unknown command: $argv[1]"
        echo "Run 'agents help' for usage."
        return 1
end
