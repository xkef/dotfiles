#!/usr/bin/env fish
# agents: coding agent tools, one command over the helpers in
# ~/.local/libexec/agents. `dots` manages the dotfiles and knows nothing of
# these. Hooks and the pi extension call the helpers directly, so a tool
# event pays no fish startup.
#
# Usage: agents [command] [args]

set -l libexec ~/.local/libexec/agents

switch "$argv[1]"
    case ''
        # The agent picker, inside tmux or WezTerm.
        if set -q TMUX; or set -q WEZTERM_PANE
            $libexec/mux-agents
        else
            agents help
        end
    case task
        # @key agents :: task :: Publish this pane's task summary to the picker
        $libexec/agent-state task $argv[2..-1]
    case state
        # @key agents :: state :: Set, clear, or list the agent state the picker reads
        $libexec/agent-state $argv[2..-1]
    case skills
        # @key agents :: skills :: Refresh shared agent skills from upstream
        $libexec/agent-skills $argv[2..-1]
    case trace
        # @key agents :: trace :: Report failed tool calls in Claude Code sessions
        $libexec/agent-trace $argv[2..-1]
    case vm
        # @key agents :: vm :: Claude Code or a shell on a repository copy in the Lima VM
        $libexec/lima-agent $argv[2..-1]
    case help -h --help
        echo "Usage: agents [command]"
        echo ""
        echo "Without a command, opens the agent picker in tmux or WezTerm."
        echo ""
        echo "Commands:"
        # Each command's @key line, which dots-ref lists too.
        awk -F ' :: ' '/^ *# @key agents :: / { printf "  %-9s %s\n", $2, $3 }' (status filename)
        echo ""
    case '*'
        echo "Unknown command: $argv[1]"
        echo "Run 'agents help' for usage."
        return 1
end
