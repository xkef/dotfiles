#!/usr/bin/env bash
# Agent picker across every WezTerm workspace or tmux session.
#
# Joins the entries from `agent-state list`, keyed by pane, against the
# live pane list. An agent whose pane is gone has no row to join to, so a
# crashed agent drops out of the view on its own. Claude Code writes those
# entries from a hook and pi from an extension.
#
#   mux-agents          tv picker. Enter switches to the agent's pane.
#   mux-agents --count  tmux status segment ("2• 1◦"), empty without agents
#   mux-agents preview <pane> <lines>  the pane's last lines
#
# Inside tmux, where the picker runs in a popup, it lists tmux panes and
# jumps with switch-client. Otherwise it lists WezTerm panes and jumps by
# focusing the pane through `wezterm cli` and setting the switch_workspace
# user var to the pane's workspace. ~/.config/wezterm/picker.lua reads it,
# closes the picker, which waits until then, and switches.
set -euo pipefail

# How long the WezTerm picker waits to be closed after it reports a choice.
readonly PICKER_WAIT=5

# Size in percent of the preview inside the picker.
readonly PREVIEW_SIZE=75

# tmux pane keys carry the host, as agent-state writes them.
readonly TMUX_KEY=tmux-${HOSTNAME%%.*}-
if [ -n "${TMUX:-}" ]; then
  readonly MUX=tmux
  # The popup already insets the picker.
  readonly UI_SCALE=100
else
  readonly MUX=wezterm
  # The picker runs in a zoomed split that fills the tab, and the scale
  # insets it like a popup.
  readonly UI_SCALE=90
fi

# Glyph weight encodes the state, so the picker doesn't need color. A
# filled dot needs input, a ring works, a small dot idles.
readonly ICON_WAITING='•'
readonly ICON_BUSY='◦'
readonly ICON_RUNNING='○'
readonly ICON_IDLE='·'
# The shield marks an agent in the Lima VM, as tab titles and the status
# line do. Its pane reports the VM host through OSC 7.
readonly SANDBOX_MARK=''
readonly SANDBOX_CWD='file://lima-dev/'

# Sort ranks: needs input first, working next, idle last.
readonly RANK_WAITING=0
readonly RANK_BUSY=1
readonly RANK_RUNNING=2
readonly RANK_IDLE=3

# Emits tab-separated rank, pane, target, state, agent, tool, age, dir, and task.
collect() {
  local now pane target agent state tool epoch cwd task rank age sandboxed
  now=$(date +%s)
  sandboxed=" $(sandbox_panes | tr '\n' ' ') "

  while IFS=$'\t' read -r pane target agent state tool epoch cwd task; do
    age=$(human_age $((now - epoch)))
    [[ "$sandboxed" == *" $pane "* ]] && agent="$SANDBOX_MARK $agent"

    case "$state" in
    waiting) rank=$RANK_WAITING ;;
    busy) rank=$RANK_BUSY ;;
    running) rank=$RANK_RUNNING ;;
    *) rank=$RANK_IDLE ;;
    esac

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$rank" "$pane" "$target" "$state" "$agent" "$tool" \
      "$age" "${cwd/#$HOME/~}" "$task"
  done < <(join_panes) |
    sort -n
}

# Emits tab-separated pane, target, and the `agent-state list` fields after
# the pane, for every entry whose pane is live. The pane side splits on the
# first space, which a pane key never holds.
join_panes() {
  awk -F'\t' -v OFS='\t' '
    FILENAME == ARGV[1] { entry[$1] = substr($0, length($1) + 2); next }
    {
      split_at = index($0, " ")
      pane = substr($0, 1, split_at - 1)
      if (pane in entry) { print pane, substr($0, split_at + 1), entry[pane] }
    }
  ' <(agent-state list) <(live_panes)
}

# Emits wezterm-<pane> for every pane that runs in the Lima VM. Inside
# tmux the picker runs where the agents do, so none are marked.
sandbox_panes() {
  [ "$MUX" = wezterm ] || return 0
  wezterm cli list --format json |
    jq -r --arg cwd "$SANDBOX_CWD" '.[] | select(.cwd | startswith($cwd)) | "wezterm-\(.pane_id)"'
}

# Emits "key target" for every live pane. A target reads "workspace:tab"
# in WezTerm and "session:window" in tmux.
live_panes() {
  if [ "$MUX" = tmux ]; then
    tmux list-panes -a -F '#{pane_id} #{session_name}:#{window_index}' |
      sed "s/^%/$TMUX_KEY/"
  else
    mux-tabs panes | awk -F'\t' '{ print "wezterm-" $1 " " $3 }'
  fi
}

human_age() { # seconds to "12s", "6m", or "2h"
  local s=$1
  ((s < 60)) && {
    printf '%ds' "$s"
    return
  }
  ((s < 3600)) && {
    printf '%dm' $((s / 60))
    return
  }
  printf '%dh' $((s / 3600))
}

# ── Preview mode ─────────────────────────────────────
if [[ "${1:-}" == preview ]]; then
  if [ "$MUX" = tmux ]; then
    tmux capture-pane -p -e -t "$2" | tail -n "$3"
  else
    mux-tabs preview "$2" "$3"
  fi
  exit 0
fi

# ── Count mode ───────────────────────────────────────
# Counts every agent in the picker's sort order, so a count keeps its
# position as the states around it change. A state without agents produces
# nothing, and with no agents at all the segment stays empty.
if [[ "${1:-}" == --count ]]; then
  waiting=0 busy=0 running=0 idle=0
  while IFS=$'\t' read -r _ _ _ state _; do
    case "$state" in
    waiting) ((++waiting)) ;;
    busy) ((++busy)) ;;
    running) ((++running)) ;;
    *) ((++idle)) ;;
    esac
  done < <(collect)

  segment=""
  append() { segment="$segment${segment:+ }$1$2"; }
  ((waiting > 0)) && append "$waiting" "$ICON_WAITING"
  ((busy > 0)) && append "$busy" "$ICON_BUSY"
  ((running > 0)) && append "$running" "$ICON_RUNNING"
  ((idle > 0)) && append "$idle" "$ICON_IDLE"

  [ -n "$segment" ] && printf '%s  ' "$segment"
  exit 0
fi

# ── Picker mode ──────────────────────────────────────
# Each tv line is "pane<TAB>target<TAB>display". tv shows only the
# rendered column, so a path with spaces can't break the field split.
#
# Each column takes the width of its widest value, and a column that stays
# empty for every agent disappears. Fixed widths padded one agent out to a line
# of mostly blanks.
render() {
  local _rank pane target state agent tool age dir task icon display row id
  local -a entries=()
  # Rows use a unit separator instead of a tab. read treats a tab as
  # whitespace and folds a run of them into one, which would shift every column
  # of an agent without a tool.
  local -r SEP=$'\x1f'
  local w_state=0 w_agent=0 w_target=0 w_dir=0 w_tool=0 w_task=0

  while IFS=$'\t' read -r _rank pane target state agent tool age dir task; do
    [[ "$tool" == - ]] && tool=""
    [[ "$task" == - ]] && task=""
    entries+=("$pane$SEP$target$SEP$state$SEP$agent$SEP$tool$SEP$age$SEP$dir$SEP$task")
    ((${#state} > w_state)) && w_state=${#state}
    ((${#agent} > w_agent)) && w_agent=${#agent}
    ((${#target} > w_target)) && w_target=${#target}
    ((${#dir} > w_dir)) && w_dir=${#dir}
    ((${#tool} > w_tool)) && w_tool=${#tool}
    ((${#task} > w_task)) && w_task=${#task}
  done

  ((w_state > 0)) || return 0
  for row in "${entries[@]}"; do
    IFS=$SEP read -r pane target state agent tool age dir task <<<"$row"
    case "$state" in
    waiting) icon=$ICON_WAITING ;;
    busy) icon=$ICON_BUSY ;;
    running) icon=$ICON_RUNNING ;;
    *) icon=$ICON_IDLE ;;
    esac

    printf -v display '%s %-*s  %-*s  %-*s' \
      "$icon" "$w_state" "$state" \
      "$w_agent" "$agent" "$w_target" "$target"
    if ((w_task > 0)); then
      printf -v display '%s  %-*s' "$display" "$w_task" "$task"
    fi
    printf -v display '%s  %-*s' "$display" "$w_dir" "$dir"
    if ((w_tool > 0)); then
      printf -v display '%s  %-*s' "$display" "$w_tool" "$tool"
    fi
    printf -v display '%s  %s' "$display" "$age"

    # The multiplexer's own pane id: 12 in WezTerm, %12 in tmux.
    case "$pane" in
    wezterm-*) id=${pane#wezterm-} ;;
    *) id=%${pane##*-} ;;
    esac
    printf '%s\t%s\t%s\n' "$id" "$target" "$display"
  done
}

rows=$(collect | render)
if [ -z "$rows" ]; then
  echo "No agents running"
  sleep 1
  exit 0
fi

# tv can't follow the end of a preview, so the preview keeps as many of the
# pane's last lines as fit. See mux-tabs.
height=$(stty size </dev/tty | cut -d' ' -f1)
preview_lines=$((height * UI_SCALE * PREVIEW_SIZE / 10000 - 6))

selection=$(printf '%s\n' "$rows" | tv \
  --ui-scale "$UI_SCALE" --no-sort --no-remote \
  --source-display '{split:\t:2}' \
  --input-header 'agents' \
  --keybindings 'tab="select_next_entry";backtab="select_prev_entry"' \
  --layout portrait --preview-size "$PREVIEW_SIZE" \
  --preview-header '{split:\t:1}' \
  --preview-command "mux-agents preview {split:\t:0} $preview_lines")
[ -n "$selection" ] || exit 0

IFS=$'\t' read -r pane target _ <<<"$selection"
if [ "$MUX" = tmux ]; then
  tmux switch-client -t "$target"
  tmux select-pane -t "$pane"
  exit 0
fi
wezterm cli activate-pane --pane-id "$pane"
printf '\033]1337;SetUserVar=switch_workspace=%s\007' \
  "$(printf '%s\t' "${target%:*}" | base64 | tr -d '\n')" >/dev/tty
sleep "$PICKER_WAIT"
