#!/usr/bin/env bash
# Runs Claude Code, or fish, in the Lima VM from ~/.config/lima/dev.yaml,
# on a copy of the current repository. The VM is the sandbox: the copy
# sits at the host's path, and the VM holds only the tokens set below.
# `agents vm` runs this script.
#
#   agents vm [flags] [claude args...]   Claude Code, permission prompts off
#   agents vm [flags] shell              fish, which `prefix v` opens
#   agents vm take                       apply the copy's changes to the host
#   agents vm drop                       discard the copy's changes
#   agents vm set claude|github          store a token for the VM
#   agents vm update                     rebuild the VM from dev.yaml
#
#   --net off|trusted|full   network for the session, trusted by default
#   --github                 pass the GitHub token to the session
#
# The session runs in nono with the profile `vm`, which lets it write only
# the repository copy, the agent state, and caches. Under --net off it
# reaches only Anthropic, under trusted also GitHub and package
# registries, and under full anything. nono's proxy enforces the domains,
# and no_new_privs keeps sudo from lifting any of it.
#
# Each launch copies the host's working tree into the VM, untracked files
# included and ignored files left out. It replaces the copy only while the
# copy holds no changes of its own, so work in the VM waits for `take` or
# `drop`. When the shell or the agent exits, the script shows the changes
# and asks which. `take` applies the copy's changes, commits included, to
# the host's working tree as a patch. A patch changes files only, so
# nothing the VM writes runs on the host before you review it.
#
# `set` stores the tokens in 1Password, as the items "lima-agent claude"
# and "lima-agent github", and in the VM under ~/.local/state/lima-agent,
# which the profile `vm` doesn't grant. A launch reads them there, since
# 1Password takes seconds, and `update` copies them into the rebuilt VM.
# Every session gets the Claude token as CLAUDE_CODE_OAUTH_TOKEN when it
# exists, and the GitHub token as GH_TOKEN under --github. They travel
# through stdin and files, so they never show up in a process list.
# WEZTERM_PANE goes along so the agent's hooks report to the `mux-agents`
# picker.
set -euo pipefail

readonly VM=dev
readonly CONFIG="$HOME/.config/lima/dev.yaml"
readonly VAULT=Private
# Guest directory under $HOME that holds the tokens.
readonly TOKEN_DIR=.local/state/lima-agent
# Guest refs: the latest host copy, and the one the guest's tree started from.
readonly HOST_REF=refs/lima/host
readonly BASE_REF=refs/lima/base
readonly ANTHROPIC_DOMAINS=(api.anthropic.com platform.claude.com)
readonly TRUSTED_DOMAINS=(
  github.com api.github.com codeload.github.com '*.githubusercontent.com'
  registry.npmjs.org nodejs.org
  pypi.org files.pythonhosted.org
  crates.io static.crates.io index.crates.io
  proxy.golang.org sum.golang.org
)

# Prints the token stored under name $1, or nothing.
token() {
  op read "op://$VAULT/lima-agent $1/password" 2>/dev/null || :
}

# Copies the token under name $1 from stdin into the VM. Empty input
# deletes the VM's copy.
store_in_vm() {
  limactl shell --start --workdir / "$VM" -- sh -c '
    umask 077 && mkdir -p "$HOME/$1" && f="$HOME/$1/$2" && cat >"$f" &&
      { [ -s "$f" ] || rm "$f"; }' sh "$TOKEN_DIR" "$1"
}

# Reads a token from stdin and stores it under name $1, replacing the old
# one. Empty input typed at the terminal only deletes the old one. Empty
# input from a pipe, such as a failed `op read`, changes nothing.
set_token() {
  local name=${1:-} value
  case "$name" in
  claude) echo "Paste the token that \`claude setup-token\` prints:" >&2 ;;
  github) echo "Paste a token from https://github.com/settings/personal-access-tokens/new:" >&2 ;;
  *)
    echo "usage: agents vm set claude|github" >&2
    exit 2
    ;;
  esac
  IFS= read -rs value || :
  if [ -z "$value" ] && [ ! -t 0 ]; then
    echo "agents vm: no token on stdin, nothing changed" >&2
    exit 1
  fi

  printf '%s' "$value" | store_in_vm "$name"
  op item delete "lima-agent $name" --vault "$VAULT" 2>/dev/null || :
  [ -n "$value" ] || return 0
  jq -n --arg title "lima-agent $name" --arg value "$value" '{
    title: $title,
    category: "PASSWORD",
    fields: [{id: "password", type: "CONCEALED", purpose: "PASSWORD", value: $value}]
  }' | op item create --vault "$VAULT" - >/dev/null
}

# Rebuilds the VM, which provisions current packages, Claude Code, and the
# host's dotfiles.
update() {
  local answer
  read -rp "Delete the VM, with every repository copy in it, and rebuild it? [y/N] " answer
  case "$answer" in y*) ;; *) exit 1 ;; esac
  limactl delete --force "$VM" 2>/dev/null || :
  limactl start --tty=false --name="$VM" --timeout=30m "$CONFIG"
  for name in claude github; do
    token "$name" | store_in_vm "$name"
  done
}

net=trusted
github=false
while [ $# -gt 0 ]; do
  case "$1" in
  --net)
    net=${2:-}
    shift
    [ $# -eq 0 ] || shift
    ;;
  --net=*)
    net=${1#*=}
    shift
    ;;
  --github)
    github=true
    shift
    ;;
  *) break ;;
  esac
done

case "$net" in
off) domains=("${ANTHROPIC_DOMAINS[@]}") ;;
trusted) domains=("${ANTHROPIC_DOMAINS[@]}" "${TRUSTED_DOMAINS[@]}") ;;
full) domains=() ;;
*)
  echo "agents vm: --net takes off, trusted, or full" >&2
  exit 2
  ;;
esac
nono_args=(run --silent --profile vm)
for domain in ${domains[@]+"${domains[@]}"}; do
  nono_args+=(--allow-domain "$domain")
done

mode=claude
case "${1:-}" in
shell | take | drop | set | update)
  mode=$1
  shift
  ;;
esac

case "$mode" in
set)
  set_token "$@"
  exit
  ;;
update)
  update
  exit
  ;;
esac

if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
  if [ "$mode" = shell ]; then
    exec limactl shell --start "$VM" -- nono "${nono_args[@]}" -- fish -l
  fi
  echo "agents vm: $PWD is not in a git repository" >&2
  exit 1
fi
workdir="$root/$(git rev-parse --show-prefix)"

# Runs the sh script in $1 in the guest, with the repository root as its $1
# and the remaining arguments after it.
guest() {
  limactl shell --start --workdir / "$VM" -- sh -c "$1" sh "$root" "${@:2}"
}

# Commits the host's working tree through a temporary index, so the host's
# index and history stay untouched.
snapshot() {
  local dir tree
  dir=$(mktemp -d)
  cp "$(git rev-parse --git-path index)" "$dir/index" 2>/dev/null || :
  GIT_INDEX_FILE="$dir/index" git add -A :/
  tree=$(GIT_INDEX_FILE="$dir/index" git write-tree)
  rm -r "$dir"
  git commit-tree --no-gpg-sign -p HEAD -m "lima-agent: host working tree" "$tree"
}

# Runs the sh script in $1 in the guest repository, inside nono without
# network. The session can write the repository's hooks and config, which
# git would otherwise run outside the sandbox.
JAIL="nono run --silent --profile vm --allow $(printf %q "$root") --block-net --"
readonly JAIL
guest_git() {
  # shellcheck disable=SC2086 # JAIL splits into words.
  limactl shell --start --workdir "$root" "$VM" -- $JAIL sh -c "$1" sh "${@:2}"
}

drop() {
  guest_git 'git reset -q --hard '"$BASE_REF"' && git clean -fdq'
}

# Shows the VM copy's changes and applies them. With "ask", as a session
# ends, it asks first whether to take, drop, or keep them.
review() {
  local patch answer=t
  patch=$(mktemp "${TMPDIR:-/tmp}/lima-agent.XXXXXX")
  guest_git 'git add -A && git diff --cached --binary '"$BASE_REF" >"$patch"
  if [ ! -s "$patch" ]; then
    rm "$patch"
    [ "$1" = ask ] || echo "agents vm: the VM copy has no changes"
    return
  fi

  git apply --stat "$patch"
  if [ "$1" = ask ]; then
    read -rp "Take, drop, or keep the VM changes? [t/d/K] " answer
  fi
  case "$answer" in
  t*)
    if ! git -C "$root" apply "$patch"; then
      echo "agents vm: the patch does not apply, see $patch" >&2
      exit 1
    fi
    drop
    ;;
  d*) drop ;;
  esac
  rm "$patch"
}

case "$mode" in
take)
  review now
  exit
  ;;
drop)
  drop
  exit
  ;;
esac

# The VM mounts the agent state directory and its transcript directory,
# which must exist first.
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/agents/lima-$VM/claude-projects"
mkdir -p "$HOME/.cache/lima-clipboard"

# The tokens the session must have.
needed=""
[ "$mode" != claude ] || needed+=" claude"
[ "$github" = false ] || needed+=" github"

# Checks the tokens, then creates the guest repository on first use. It
# commits under the host's name without signing, since the guest has no
# signing key.
guest 'for name in $4; do
  [ -s "$HOME/$5/$name" ] || { echo "agents vm: no $name token, run agents vm set $name" >&2; exit 1; }
done
[ -d "$1/.git" ] || {
  sudo install -d -o "$(id -u)" -g "$(id -g)" "$1" &&
    git init -q "$1" &&
    git -C "$1" config user.name "$2" &&
    git -C "$1" config user.email "$3" &&
    git -C "$1" config commit.gpgsign false
}' "$(git config user.name)" "$(git config user.email)" "$needed" "$TOKEN_DIR"

git push -q -f --receive-pack="$JAIL git-receive-pack" "lima-$VM:$root" "$(snapshot):$HOST_REF"

# The guest's fish runs without a prompt, so it never reports its
# directory. OSC 7 with the VM's host name tells WezTerm the pane works in
# the VM, which the status line marks and splits follow.
if [ -t 1 ]; then
  printf '\e]7;file://lima-%s%s\e\\' "$VM" "$workdir"
fi

session=(fish -l)
if [ "$mode" = claude ]; then
  # shellcheck disable=SC2016 # fish expands $argv.
  session=(fish -lc 'claude $argv' "$@")
fi

# Replaces the copy while it holds nothing since the last copy, then starts
# the session in nono. Plain sh runs outside the sandbox, so no shell
# config that the session can write runs there.
rc=0
refresh='if [ -z "$(git status --porcelain)" ] &&
  [ "$(git rev-parse -q --verify HEAD)" = "$(git rev-parse -q --verify '"$BASE_REF"')" ]; then
  git reset -q --hard '"$HOST_REF"' && git update-ref '"$BASE_REF $HOST_REF"'
else
  echo "agents vm: the VM copy has changes, which agents vm take or drop clears" >&2
fi'
limactl shell --workdir "$root" "$VM" -- sh -c '
  workdir=$1 jail=$2 refresh=$3 tokens=$HOME/$4 needed=$5
  export WEZTERM_PANE="$6"
  shift 6
  if [ -s "$tokens/claude" ]; then
    CLAUDE_CODE_OAUTH_TOKEN=$(cat "$tokens/claude") && export CLAUDE_CODE_OAUTH_TOKEN
  fi
  case "$needed" in *github*) GH_TOKEN=$(cat "$tokens/github") && export GH_TOKEN ;; esac

  $jail sh -c "$refresh"
  cd "$workdir" || exit

  # First-run onboarding asks for a login even with a token set, and the
  # VM replaces the folder trust prompt. Claude Code rewrites this file
  # while it runs, so it changes only when a key is missing.
  cfg=$HOME/.claude.json
  [ -f "$cfg" ] || echo "{}" >"$cfg"
  if ! jq -e --arg dir "$PWD" ".hasCompletedOnboarding and .projects[\$dir].hasTrustDialogAccepted" "$cfg" >/dev/null; then
    tmp=$(mktemp) &&
      jq --arg dir "$PWD" ".hasCompletedOnboarding = true | .projects[\$dir].hasTrustDialogAccepted = true" "$cfg" >"$tmp" &&
      mv "$tmp" "$cfg"
  fi

  exec nono "$@"' sh "$workdir" "$JAIL" "$refresh" "$TOKEN_DIR" "$needed" "${WEZTERM_PANE:-}" \
  "${nono_args[@]}" --allow "$root" -- "${session[@]}" || rc=$?
review ask
exit "$rc"
