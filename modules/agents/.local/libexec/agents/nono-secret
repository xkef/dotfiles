#!/bin/sh
# Prints the secret stored under service nono and the given account, from
# the keychain on macOS or the Secret Service on Linux.
#
#   nono-secret <account>
#
# nono runs this on the host for its credential proxy. nono could read the
# keychain itself, but Homebrew builds it ad-hoc signed, so macOS forgets
# "Always Allow" with every upgrade and asks for the login password again.
# The security tool already has access to the items it created.
set -eu

if [ $# -ne 1 ]; then
  sed -n 's/^#   //p' "$0" >&2
  exit 2
fi

if command -v security >/dev/null; then
  exec security find-generic-password -s nono -a "$1" -w
fi
exec secret-tool lookup service nono account "$1"
