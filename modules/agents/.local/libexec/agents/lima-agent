#!/usr/bin/env bash
# Runs Claude Code, or fish, in the Lima VM from ~/.config/lima/dev.yaml,
# on a copy of the current repository. The VM is the sandbox: the copy
# sits at the host's path, and the VM holds no token.
# `agents vm` runs this script.
#
#   agents vm [flags] [claude args...]   Claude Code, permission prompts off
#   agents vm [flags] shell              fish, which `leader v` opens
#   agents vm [flags] pane DIR           fish in DIR on the copy as it stands
#   agents vm take                       apply the copy's changes to the host
#   agents vm drop                       discard the copy's changes
#   agents vm update                     rebuild the VM from dev.yaml
#
#   --github                 give the session GitHub through the proxy
#
# The VM is the only sandbox. The session may write anywhere in the guest
# and reach any host, and holds no secret.
#
# Each launch copies the host's working tree into the VM, untracked files
# included and ignored files left out. It replaces the copy only while the
# copy holds no changes of its own, so work in the VM waits for `take` or
# `drop`. When the shell or the agent exits, the script shows the changes
# and asks which. `take` applies the copy's changes, commits included, to
# the host's working tree as a patch. A patch changes files only, so
# nothing the VM writes runs on the host before you review it.
#
# Each session runs behind its own nono credential proxy on the host,
# which the guest reaches at host.lima.internal. The proxy reads the
# tokens from the keychain, the ones `sb` uses too, and adds them to
# requests to Anthropic, and under --github to GitHub. The session holds
# placeholders and the proxy's password, which works only while the
# session runs. The password travels through stdin and a file, so it
# never shows up in a process list. The proxy signs TLS with a CA that
# the script creates once on the host, and the guest trusts it.
# WEZTERM_PANE goes along so the agent's hooks report to the `mux-agents`
# picker.
set -euo pipefail

# The VM's name. WezTerm's lima.lua names it too, and dev.yaml derives
# its mounts from it.
readonly VM=dev
readonly CONFIG="$HOME/.config/lima/dev.yaml"
readonly STATE="${XDG_STATE_HOME:-$HOME/.local/state}/lima-agent"
readonly CA_CERT="$STATE/ca.pem"
readonly CA_KEY="$STATE/ca.key"
# Guest directory under $HOME that holds the proxy passwords.
readonly PASS_DIR=.local/state/lima-agent
# Where the guest trusts the proxy's CA.
readonly GUEST_CA=/etc/ca-certificates/trust-source/anchors/lima-agent.pem
# Any value works, since the proxy replaces it.
readonly PLACEHOLDER=nono-proxy
# Guest refs: the latest host copy, and the one the guest's tree started from.
readonly HOST_REF=refs/lima/host
readonly BASE_REF=refs/lima/base
# nono rejects LibreSSL's EC keys, and Homebrew keeps openssl@3 keg-only.
# Without Homebrew, as on Linux, the openssl on PATH is OpenSSL 3.
OPENSSL="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/openssl@3/bin/openssl"
[ -x "$OPENSSL" ] || OPENSSL=openssl
readonly OPENSSL

if ! command -v limactl >/dev/null; then
  echo "agents vm: limactl not found; the VM runs on macOS with Lima" >&2
  exit 1
fi

# Rebuilds the VM, which provisions current packages, Claude Code, and the
# host's dotfiles. The next launch makes it trust the proxy's CA.
update() {
  local answer
  read -rp "Delete the VM, with every repository copy in it, and rebuild it? [y/N] " answer
  case "$answer" in y*) ;; *) exit 1 ;; esac
  limactl delete --force "$VM" 2>/dev/null || :
  # dev.yaml mounts ~/dotfiles. The mount follows the repo wherever it sits.
  limactl start --tty=false --name="$VM" --timeout=30m \
    --set ".mounts[0].location = \"${DOTFILES_DIR:?}\"" "$CONFIG"
}

# Creates the proxy's CA once.
ensure_ca() {
  [ ! -s "$CA_CERT" ] || return 0
  mkdir -p "$STATE"
  (umask 077 && "$OPENSSL" req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
    -keyout "$CA_KEY" -out "$CA_CERT" -days 3650 -subj "/CN=lima-agent proxy" \
    -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign 2>/dev/null)
}

# Starts this session's credential proxy, which stops when the script
# exits, and sets $proxy_url to its address with the password. The
# proxy adds the GitHub routes from the agents profile under --github.
start_proxy() {
  local log pass port profiles=(-p lima)
  [ "$github" = false ] || profiles+=(--extends agents)
  log=$(mktemp "${TMPDIR:-/tmp}/lima-agent.XXXXXX")
  pass=$("$OPENSSL" rand -hex 16)
  NONO_PROXY_PASS=$pass nono proxy "${profiles[@]}" \
    --proxy-ca-cert "$CA_CERT" --proxy-ca-key "$CA_KEY" </dev/null >"$log" 2>&1 &
  proxy_pid=$!
  trap 'kill "$proxy_pid" 2>/dev/null' EXIT

  # The keychain may ask for access first.
  until port=$(sed -n 's/.*listening on 127\.0\.0\.1:\([0-9]*\).*/\1/p' "$log") && [ -n "$port" ]; do
    if ! kill -0 "$proxy_pid" 2>/dev/null; then
      cat "$log" >&2
      rm "$log"
      exit 1
    fi
    sleep 0.2
  done
  rm "$log"
  proxy_url="http://nono:$pass@host.lima.internal:$port"
  proxy_file="proxy-$port"
}

github=false
if [ "${1:-}" = --github ]; then
  github=true
  shift
fi

mode=claude
case "${1:-}" in
shell | pane | take | drop | update)
  mode=$1
  shift
  ;;
esac

case "$mode" in
update)
  update
  exit
  ;;
pane)
  # A split or new tab of a VM pane: fish in the pane's directory, on the
  # repository copy as it stands.
  exec limactl shell --start "$VM" -- sh -c 'cd "$1" && export WEZTERM_PANE="$2" &&
    exec fish -l' sh "${1:?}" "${WEZTERM_PANE:-}"
  ;;
esac

if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
  if [ "$mode" = shell ]; then
    exec limactl shell --start "$VM" -- fish -l
  fi
  echo "agents vm: $PWD is not in a git repository" >&2
  exit 1
fi
workdir="$root/$(git rev-parse --show-prefix)"

# Runs the sh script in $1 in the guest, with the repository root as its $1
# and the remaining arguments after it.
guest() {
  limactl shell --start --workdir / "$VM" -- sh -c "$1" sh "$root" "${@:2}"
}

# Commits the host's working tree through a temporary index, so the host's
# index and history stay untouched.
# A repository without commits gets a root commit.
snapshot() {
  local dir tree parent=()
  dir=$(mktemp -d)
  cp "$(git rev-parse --git-path index)" "$dir/index" 2>/dev/null || :
  GIT_INDEX_FILE="$dir/index" git add -A :/
  tree=$(GIT_INDEX_FILE="$dir/index" git write-tree)
  rm -r "$dir"
  if git rev-parse -q --verify HEAD >/dev/null; then
    parent=(-p HEAD)
  fi
  git commit-tree --no-gpg-sign ${parent[@]+"${parent[@]}"} -m "lima-agent: host working tree" "$tree"
}

# Runs the sh script in $1 in the guest repository.
guest_git() {
  limactl shell --start --workdir "$root" "$VM" -- sh -c "$1" sh "${@:2}"
}

drop() {
  guest_git 'git reset -q --hard '"$BASE_REF"' && git clean -fdq'
}

# Shows the VM copy's changes and applies them. With "ask", as a session
# ends, it asks first whether to take, drop, or keep them.
review() {
  local patch answer=t
  patch=$(mktemp "${TMPDIR:-/tmp}/lima-agent.XXXXXX")
  guest_git 'git add -A && git diff --cached --binary '"$BASE_REF" >"$patch"
  if [ ! -s "$patch" ]; then
    rm "$patch"
    [ "$1" = ask ] || echo "agents vm: the VM copy has no changes"
    return
  fi

  git apply --stat "$patch"
  if [ "$1" = ask ]; then
    # A changed file such as mise.toml or .envrc runs on the host once
    # taken, so the whole patch shows before the question.
    if [ -t 0 ] && [ -t 1 ]; then
      "${PAGER:-less}" "$patch"
    fi
    read -rp "Take, drop, or keep the VM changes? [t/d/K] " answer
  fi
  case "$answer" in
  t*)
    if ! git -C "$root" apply "$patch"; then
      echo "agents vm: the patch does not apply, see $patch" >&2
      exit 1
    fi
    drop
    ;;
  d*) drop ;;
  esac
  rm "$patch"
}

case "$mode" in
take)
  review now
  exit
  ;;
drop)
  drop
  exit
  ;;
esac

# The VM mounts the agent state directory and its transcript directory,
# which must exist first.
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/agents/lima-$VM/claude-projects"
mkdir -p "$HOME/.cache/lima-clipboard"

ensure_ca
start_proxy

# Stores the proxy's address from stdin's first line, makes the guest
# trust the CA that follows it, then creates the guest repository on
# first use. It commits under the host's name without signing, since the
# guest has no signing key.
{
  printf '%s\n' "$proxy_url"
  cat "$CA_CERT"
} | guest '
IFS= read -r url
(umask 077 && mkdir -p "$HOME/$4" && printf "%s" "$url" >"$HOME/$4/$5")
ca=$(mktemp) && cat >"$ca"
cmp -s "$ca" "$6" || { sudo install -m 644 "$ca" "$6" && sudo update-ca-trust; }
rm "$ca"
[ -d "$1/.git" ] || {
  sudo install -d -o "$(id -u)" -g "$(id -g)" "$1" &&
    git init -q "$1" &&
    git -C "$1" config user.name "$2" &&
    git -C "$1" config user.email "$3" &&
    git -C "$1" config commit.gpgsign false
}' "$(git config user.name || echo "$USER")" "$(git config user.email || echo "$USER@localhost")" "$PASS_DIR" "$proxy_file" "$GUEST_CA"

snap=$(snapshot)
git push -q -f "lima-$VM:$root" "$snap:$HOST_REF"

# The guest's fish runs without a prompt, so it never reports its
# directory. OSC 7 with the VM's host name tells WezTerm the pane works in
# the VM, which the status line marks and splits follow.
if [ -t 1 ]; then
  printf '\e]7;file://lima-%s%s\e\\' "$VM" "$workdir"
fi

session=(fish -l)
if [ "$mode" = claude ]; then
  # shellcheck disable=SC2016 # fish expands $argv.
  session=(fish -lc 'claude $argv' "$@")
fi

# Replaces the copy while it holds nothing since the last copy, then starts
# the session.
rc=0
refresh='if [ -z "$(git status --porcelain)" ] &&
  [ "$(git rev-parse -q --verify HEAD)" = "$(git rev-parse -q --verify '"$BASE_REF"')" ]; then
  git reset -q --hard '"$HOST_REF"' && git update-ref '"$BASE_REF $HOST_REF"'
else
  echo "agents vm: the VM copy has changes, which agents vm take or drop clears" >&2
fi'
# Requests to localhost stay in the guest, since the proxy would send
# them to the host's.
limactl shell --workdir "$root" "$VM" -- sh -c '
  workdir=$1 refresh=$2 pass_file=$HOME/$3 github=$4 placeholder=$5
  export WEZTERM_PANE="$6" NODE_EXTRA_CA_CERTS="$7"
  shift 7
  proxy=$(cat "$pass_file") && rm "$pass_file" || exit
  export HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" NO_PROXY=localhost,127.0.0.1,::1 \
    CLAUDE_CODE_OAUTH_TOKEN="$placeholder"
  [ "$github" = false ] || export GH_TOKEN="$placeholder"

  sh -c "$refresh"
  cd "$workdir" || exit

  # First-run onboarding asks for a login even with a token set, and the
  # VM replaces the folder trust prompt. Claude Code rewrites this file
  # while it runs, so it changes only when a key is missing.
  cfg=$HOME/.claude.json
  [ -f "$cfg" ] || echo "{}" >"$cfg"
  if ! jq -e --arg dir "$PWD" ".hasCompletedOnboarding and .projects[\$dir].hasTrustDialogAccepted" "$cfg" >/dev/null; then
    tmp=$(mktemp) &&
      jq --arg dir "$PWD" ".hasCompletedOnboarding = true | .projects[\$dir].hasTrustDialogAccepted = true" "$cfg" >"$tmp" &&
      mv "$tmp" "$cfg"
  fi

  exec "$@"' sh "$workdir" "$refresh" "$PASS_DIR/$proxy_file" "$github" "$PLACEHOLDER" \
  "${WEZTERM_PANE:-}" "$GUEST_CA" "${session[@]}" || rc=$?
review ask
exit "$rc"
