#!/bin/bash

INPUT=$(cat)
FILE_PATH=$(echo "$INPUT" | jq -r '.tool_input.file_path // empty')

[ -z "$FILE_PATH" ] && exit 0

# Matches the whole file name, so .envrc or app.keymap stays writable.
case "${FILE_PATH##*/}" in
.env | .env.local | .env.production | .env.staging | \
  id_rsa | id_ed25519 | id_ecdsa | *.pem | *.key | *.p12 | \
  credentials.json | .netrc) ;;
*) [[ "$FILE_PATH" == */.aws/credentials ]] || exit 0 ;;
esac

echo "Blocked: refusing to write to sensitive file: $FILE_PATH" >&2
exit 2
