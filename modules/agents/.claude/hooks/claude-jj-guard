#!/bin/bash
# Refuses Git commands that change history or the working copy inside a jj
# repository.
#
# In a colocated repository Git works too, so agents reach for the Git
# commands they know, and jj then sees a rewritten history it didn't make.
# Read-only commands such as `git show` and `git log` pass.

readonly MUTATING='(^|[;&|(`]|\$\()[[:space:]]*git([[:space:]]+-[Cc][[:space:]]+[^[:space:]]+)*[[:space:]]+(add|am|branch|checkout|cherry-pick|clean|commit|merge|pull|push|rebase|reset|restore|revert|rm|stash|switch|tag)([^[:alnum:]-]|$)'

INPUT=$(cat)
COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty')
CWD=$(echo "$INPUT" | jq -r '.cwd // empty')

[ -z "$COMMAND" ] && exit 0
[[ "$COMMAND" =~ $MUTATING ]] || exit 0
jj --ignore-working-copy root -R "${CWD:-.}" >/dev/null 2>&1 || exit 0

echo "Blocked: this is a jj repository. Use the jj equivalent, such as jj commit, jj rebase, or jj bookmark. Git stays read-only here." >&2
exit 2
