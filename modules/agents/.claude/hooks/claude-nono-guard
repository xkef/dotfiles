#!/bin/bash
# Refuses dangerouslyDisableSandbox under nono.
#
# sb turns Claude Code's own sandbox off inside nono, so the flag lifts
# nothing there. nono still blocks the command, and the auto-mode classifier
# may deny the attempt. The user runs such a command in a separate terminal.

[ -z "${NONO_CAP_FILE:-}" ] && exit 0

INPUT=$(cat)

if echo "$INPUT" | jq -e '.tool_input.dangerouslyDisableSandbox == true' >/dev/null; then
  echo "Blocked: nono confines this session, and dangerouslyDisableSandbox has no effect under it. Hand the command to the user for a separate terminal." >&2
  exit 2
fi

exit 0
