#!/usr/bin/env bash
# CPU and memory for the WezTerm and tmux status lines, with few forks.
#
#   mux-sysstat         "<cpu%>\t<high|normal>\t<used>/<total>G", which
#                       status.lua colors
#   mux-sysstat --tmux  the same, colored with tmux style tags
set -euo pipefail

# CPU at or above this percentage reads high and turns red.
readonly CPU_HIGH=80

# Holds the last smoothed CPU and, on Linux, the busy and total jiffies.
readonly SMOOTH="${TMPDIR:-/tmp}/mux-sysstat-smooth"
OS=$(uname)
readonly OS

# ── CPU, normalized to 0-100% and smoothed ───────────
prev_cpu='' prev_busy='' prev_total=''
[ -f "$SMOOTH" ] && read -r prev_cpu prev_busy prev_total <"$SMOOTH"

# macOS ps reports a decaying average of recent load. procps ps reports CPU
# time over each process's lifetime, so Linux reads /proc/stat instead and
# takes the busy share since the last run.
busy='' cpu_total=''
if [[ "$OS" == Darwin ]]; then
  ncpu=$(sysctl -n hw.logicalcpu)
  raw=$(ps -A -o %cpu= | awk -v c="$ncpu" '{s+=$1} END {printf "%.0f", s/c}')
else
  read -r _ user nice system idle iowait irq softirq steal _ </proc/stat
  busy=$((user + nice + system + irq + softirq + steal))
  cpu_total=$((busy + idle + iowait))
  if [[ -n "$prev_total" ]] && ((cpu_total > prev_total)); then
    raw=$(((busy - prev_busy) * 100 / (cpu_total - prev_total)))
  else
    raw=$((busy * 100 / cpu_total))
  fi
fi
((raw > 100)) && raw=100

prev=${prev_cpu:-$raw}
cpu=$(awk "BEGIN {printf \"%.0f\", 0.3 * $raw + 0.7 * $prev}")
echo "$cpu $busy $cpu_total" >"$SMOOTH"

level=normal
((cpu >= CPU_HIGH)) && level=high

# ── Memory, used / total ─────────────────────────────
if [[ "$OS" == Darwin ]]; then
  {
    read -r page_size
    read -r total
  } <<<"$(sysctl -n hw.pagesize hw.memsize)"
  used=$(vm_stat | awk -v ps="$page_size" '
    /Pages active/           { gsub(/[^0-9]/,"",$NF); a=$NF }
    /Pages wired/            { gsub(/[^0-9]/,"",$NF); w=$NF }
    /occupied by compressor/ { gsub(/[^0-9]/,"",$NF); c=$NF }
    END { printf "%.0f", (a + w + c) * ps }')
else
  read -r total used <<<"$(awk '
    /^MemTotal:/     { t=$2*1024 }
    /^MemAvailable:/ { a=$2*1024 }
    END { printf "%.0f %.0f", t, t-a }' /proc/meminfo)"
fi
mem_pct=$((used * 100 / total))
((mem_pct > 100)) && mem_pct=100

used_g=$(awk "BEGIN {printf \"%.1f\", $used / 1073741824}")
total_g=$(awk "BEGIN {printf \"%.0f\", $total / 1073741824}")

# ── Output ────────────────────────────────────────────
if [[ "${1:-}" == --tmux ]]; then
  color=colour8
  [[ "$level" == high ]] && color=colour1
  printf '#[fg=%s]%d%%  #[fg=colour8]%s/%sG' "$color" "$cpu" "$used_g" "$total_g"
else
  printf '%d\t%s\t%s/%sG\n' "$cpu" "$level" "$used_g" "$total_g"
fi
