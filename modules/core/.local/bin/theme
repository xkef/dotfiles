#!/usr/bin/env fish
# theme: switches the color scheme of WezTerm, Neovim, delta, and pi
# through tinty, configured in ~/.config/tinted-theming/tinty/config.toml.
#
# Usage:
#   theme            Pick a scheme with tv
#   theme <scheme>   Apply a scheme, such as base24-catppuccin-frappe
#   theme auto       Match the system light or dark appearance
#   theme --current  Print the current scheme
#   theme --list     List the schemes

# Checks the system appearance on macOS and GNOME.
function _system_is_dark
    switch (uname)
        case Darwin
            # `defaults read -g AppleInterfaceStyle` prints "Dark" in dark
            # mode and fails otherwise. Capture the output so an empty result
            # doesn't collapse the `test` arguments.
            set -l style (defaults read -g AppleInterfaceStyle 2>/dev/null)
            test "$style" = Dark
        case Linux
            set -l scheme (gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)
            string match -q "*dark*" -- $scheme
        case '*'
            return 1
    end
end

# Defaults to Catppuccin Latte for light and Catppuccin Frappe for dark.
# DOTS_THEME_LIGHT and DOTS_THEME_DARK override them.
function _auto_theme
    set -l light (set -q DOTS_THEME_LIGHT && echo $DOTS_THEME_LIGHT || echo base24-catppuccin-latte)
    set -l dark (set -q DOTS_THEME_DARK && echo $DOTS_THEME_DARK || echo base24-catppuccin-frappe)
    if _system_is_dark
        tinty apply $dark
    else
        tinty apply $light
    end
end

switch "$argv[1]"
    case --current
        tinty current
    case --list -l
        tinty list
    case auto
        _auto_theme
    case --help -h
        sed -n 's/^#   //p' (status filename)
    case ''
        set -l scheme (tinty list | tv --no-preview --input-header theme --input (tinty current 2>/dev/null))
        test -n "$scheme"; or return
        tinty apply $scheme
    case '*'
        tinty apply $argv[1]
end
