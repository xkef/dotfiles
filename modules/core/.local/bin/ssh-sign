#!/usr/bin/env bash
# ssh-keygen for git and jj signing. With a security key, ssh-keygen
# prints the touch prompt to stderr, which git and jj capture, so the
# command would wait without a visible reason. This hands the prompt to
# ssh-prompt and passes everything else through.
#
# Without the token plugged in, it signs with the 1Password key instead.
# The 1Password agent holds that key's private half.
set -euo pipefail

readonly FALLBACK_KEY=~/.ssh/1password.pub

bin=${BASH_SOURCE[0]%/*}
sign='' key_at=''
args=("$@")
for ((i = 0; i < ${#args[@]} - 1; i++)); do
  case ${args[i]} in
  -Y) [[ ${args[i + 1]} == sign ]] && sign=1 ;;
  -f) key_at=$((i + 1)) ;;
  esac
done

if [[ -z $sign || -z $key_at || ! -r ${args[key_at]} ]]; then
  exec ssh-keygen "$@"
fi

# A security key's public key starts with its type, sk-ssh-ed25519@...
read -r type _ <"${args[key_at]}" || :
if [[ ${type:-} != sk-* ]]; then
  exec ssh-keygen "$@"
fi

if "$bin/token2-present"; then
  SSH_ASKPASS_PROMPT=none "$bin/ssh-prompt" \
    'Touch the security key to sign' >/dev/null 2>&1 &
elif [[ -r $FALLBACK_KEY ]]; then
  args[key_at]=$FALLBACK_KEY
fi

exec ssh-keygen "${args[@]}"
