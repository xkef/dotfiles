# ── Machine-local host configs ─────────────────────────
# Drop *.conf files into ~/.ssh/conf.d/ for per-host overrides, such as
# ~/.ssh/conf.d/work.conf with Host entries for work servers.
Include conf.d/*.conf

# ── Defaults ────────────────────────────────────────────
Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    StrictHostKeyChecking accept-new
    # Reuse TCP connections.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m
    # Post-quantum key exchange first. OpenSSH 10.1 and later warns on
    # connections without it.
    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256,curve25519-sha256@libssh.org
    HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com

# ── GitHub, signing key from the SSH agent ─────────────
Host github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/github.pub
