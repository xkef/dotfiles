# Personal overrides go in ~/.config/git/config.local.

[init]
	defaultBranch = main

[core]
	editor = env NVIM_APPNAME=lazyvim nvim
	pager = delta
	autocrlf = input
	untrackedCache = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname
	gpgsign = true

# ── Diff ──────────────────────────────────────────────
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

# ── Delta pager ──────────────────────────────────────
[delta]
	navigate = true
	line-numbers = true
	line-numbers-left-format = "{nm:>3} "
	line-numbers-right-format = "{np:>3} │ "
	file-modified-label = ""
	file-added-label = +
	file-removed-label = -
	file-renamed-label = →
	hunk-header-style = line-number syntax
	hyperlinks = true
	hyperlinks-file-link-format = "file://{path}:{line}"

[interactive]
	diffFilter = delta --color-only

# ── Merge / Rebase ───────────────────────────────────
[merge]
	conflictstyle = zdiff3
	tool = nvimdiff

[mergetool "nvimdiff"]
	cmd = env NVIM_APPNAME=lazyvim nvim -d "$LOCAL" "$MERGED" "$REMOTE"

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

# ── Push / Pull / Fetch ─────────────────────────────
[push]
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[fetch]
	prune = true
	pruneTags = true
	all = true

# ── Commit ───────────────────────────────────────────
[commit]
	verbose = true
	template = ~/.config/git/message
	gpgsign = true

# ── Help ─────────────────────────────────────────────
[help]
	autocorrect = prompt

# ── URL shortcuts ────────────────────────────────────
[url "https://github.com/"]
	insteadOf = "gh:"
	insteadOf = "git@github.com:"

[url "git@gitlab.com:"]
	insteadOf = "gl:"

[url "git@bitbucket.org:"]
	insteadOf = "bb:"

# ── Credentials ──────────────────────────────────────
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# ── Aliases ──────────────────────────────────────────
[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	ca = commit --amend
	cp = cherry-pick
	unstage = reset HEAD --
	last = log -1 HEAD
	dl = diff --no-ext-diff
	ds = diff --shortstat
	lg = log --oneline --graph --decorate --all -20
	ll = log --pretty=format:'%C(yellow)%h%Creset %C(blue)%ad%Creset %C(green)%an%Creset %s%C(red)%d%Creset' --date=short
	dft = -c diff.external=difft diff
	wip = !git add -A && git commit -m 'wip: checkpoint'
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	branches = for-each-ref --sort=-committerdate --format='%(refname:short) %(committerdate:relative)' refs/heads
	contributors = shortlog -sn --no-merges
	cleanup = !git branch --merged | grep -vE '^\\*|^ +(main|master)$' | xargs -n1 git branch -d
	wt = worktree
	wta = worktree add
	wtl = worktree list
	wtr = worktree remove

# ── Delta colors, written by `theme` through tinty ───
# tinted-delta sets the syntax theme. The delta hook in tinty's hooks.d
# writes the diff colors.
[include]
	path = ~/.local/share/tinted-theming/tinty/tinted-delta-configs-file.gitconfig
	path = ~/.local/share/tinted-theming/tinty/delta-colors.gitconfig

# ── SSH signing through the SSH agent ────────────────
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# ── Identity and accounts by directory ───────────────
# From the encrypted private/ files that setup/private/decrypt writes.
# Below the credentials, so an account's credential helper wins.
[include]
	path = ~/.config/git/identity

# ── Local overrides: identity, signing ───────────────
[include]
	path = ~/.config/git/config.local
