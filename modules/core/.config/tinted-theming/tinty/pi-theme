#!/usr/bin/env fish
# tinty hook: derives the pi theme from a WezTerm color file.
#
# Usage: pi-theme <wezterm-colors.toml>
#
# The tracked pi settings select the theme by name, "dots". pi watches the
# active custom theme file and reloads it on change, so rewriting it
# recolors running pi sessions. The file is machine-local and untracked.

set -l colors_file $argv[1]
test -f "$colors_file"; or exit 1

# Blends two hex colors: _blend_hex bg fg weight, with weight from 0 to 100.
function _blend_hex -a bg_hex fg_hex weight
    set -l rgb1 (string sub -l 2 $bg_hex) (string sub -s 3 -l 2 $bg_hex) (string sub -s 5 -l 2 $bg_hex)
    set -l rgb2 (string sub -l 2 $fg_hex) (string sub -s 3 -l 2 $fg_hex) (string sub -s 5 -l 2 $fg_hex)
    for i in 1 2 3
        printf '%02x' (math "round((0x$rgb1[$i] * (100 - $weight) + 0x$rgb2[$i] * $weight) / 100)")
    end
end

# The color file lists background and foreground as keys, then the 8 ansi
# and 8 bright colors as arrays, in palette order.
set -l bg (string match -rg '^background = "#([0-9a-fA-F]{6})"' <$colors_file | string lower)
set -l fg (string match -rg '^foreground = "#([0-9a-fA-F]{6})"' <$colors_file | string lower)
set -l palette (string match -rg '^\s+"#([0-9a-fA-F]{6})",?$' <$colors_file | string lower)
if test (count $palette) -lt 16; or test -z "$bg"; or test -z "$fg"
    echo "pi-theme: no palette in $colors_file" >&2
    exit 1
end

set -l pi_agent_dir (set -q PI_CODING_AGENT_DIR && echo $PI_CODING_AGENT_DIR || echo $HOME/.pi/agent)
if test -d $pi_agent_dir
    set -l pi_red $palette[2]
    set -l pi_green $palette[3]
    set -l pi_yellow $palette[4]
    set -l pi_blue $palette[5]
    set -l pi_magenta $palette[6]
    set -l pi_cyan $palette[7]
    set -l pi_orange $palette[10]
    set -l pi_br_magenta $palette[14]
    set -l pi_br_cyan $palette[15]

    # Blend the grays toward the foreground instead of taking the ANSI
    # bright-black slot, so the ramp inverts by itself under light themes.
    set -l pi_gray (_blend_hex $bg $fg 60)
    set -l pi_dim_gray (_blend_hex $bg $fg 45)
    set -l pi_dark_gray (_blend_hex $bg $fg 30)

    # Message and tool-box backgrounds: a wash of one palette color over the
    # terminal background, matching how the delta adapter tints diff hunks.
    set -l pi_selected_bg (_blend_hex $bg $pi_cyan 24)
    set -l pi_search_bg (_blend_hex $bg $pi_yellow 28)
    set -l pi_user_bg (_blend_hex $bg $pi_blue 16)
    set -l pi_custom_bg (_blend_hex $bg $pi_magenta 15)
    set -l pi_pending_bg (_blend_hex $bg $pi_cyan 8)
    set -l pi_success_bg (_blend_hex $bg $pi_green 12)
    set -l pi_error_bg (_blend_hex $bg $pi_red 14)
    set -l pi_info_bg (_blend_hex $bg $pi_yellow 18)

    # pi requires all 51 mandatory tokens in every theme. The four optional
    # ones follow so search matches and the scrollbar don't collapse into
    # selectedBg.
    set -l pi_tokens \
        accent:$pi_cyan \
        border:$pi_blue \
        borderAccent:$pi_br_cyan \
        borderMuted:$pi_dark_gray \
        success:$pi_green \
        error:$pi_red \
        warning:$pi_yellow \
        muted:$pi_gray \
        dim:$pi_dim_gray \
        text:$fg \
        thinkingText:$pi_dim_gray \
        selectedBg:$pi_selected_bg \
        scrollbarThumb:$pi_dark_gray \
        searchMatchBg:$pi_search_bg \
        searchMatchText:$fg \
        userMessageBg:$pi_user_bg \
        userMessageText:$fg \
        customMessageBg:$pi_custom_bg \
        customMessageText:$fg \
        customMessageLabel:$pi_magenta \
        toolPendingBg:$pi_pending_bg \
        toolSuccessBg:$pi_success_bg \
        toolErrorBg:$pi_error_bg \
        toolTitle:$pi_cyan \
        toolOutput:$pi_gray \
        mdHeading:$pi_yellow \
        mdLink:$pi_blue \
        mdLinkUrl:$pi_dim_gray \
        mdCode:$pi_cyan \
        mdCodeBlock:$fg \
        mdCodeBlockBorder:$pi_dark_gray \
        mdQuote:$pi_gray \
        mdQuoteBorder:$pi_magenta \
        mdHr:$pi_dark_gray \
        mdListBullet:$pi_cyan \
        toolDiffAdded:$pi_green \
        toolDiffRemoved:$pi_red \
        toolDiffContext:$pi_gray \
        syntaxComment:$pi_dim_gray \
        syntaxKeyword:$pi_magenta \
        syntaxFunction:$pi_blue \
        syntaxVariable:$fg \
        syntaxString:$pi_green \
        syntaxNumber:$pi_orange \
        syntaxType:$pi_yellow \
        syntaxOperator:$fg \
        syntaxPunctuation:$pi_gray \
        thinkingOff:$pi_dark_gray \
        thinkingMinimal:$pi_dim_gray \
        thinkingLow:$pi_blue \
        thinkingMedium:$pi_cyan \
        thinkingHigh:$pi_yellow \
        thinkingXhigh:$pi_magenta \
        thinkingMax:$pi_br_magenta \
        bashMode:$pi_green

    set -l pi_lines
    for pi_token in $pi_tokens
        set -l pi_kv (string split -m 1 : $pi_token)
        set -a pi_lines (printf '    "%s": "#%s"' $pi_kv[1] $pi_kv[2])
    end

    set -l pi_themes_dir $pi_agent_dir/themes
    command mkdir -p $pi_themes_dir
    begin
        printf '{\n'
        printf '  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",\n'
        printf '  "name": "dots",\n'
        printf '  "colors": {\n'
        string join ,\n $pi_lines
        printf '  },\n'
        printf '  "export": {\n'
        printf '    "pageBg": "#%s",\n' $bg
        printf '    "cardBg": "#%s",\n' $pi_user_bg
        printf '    "infoBg": "#%s"\n' $pi_info_bg
        printf '  }\n'
        printf '}\n'
    end >$pi_themes_dir/dots.json
end
