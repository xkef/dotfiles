#!/usr/bin/env fish
# tinty hook: writes delta's diff colors for tinty's current scheme to
# delta-colors.gitconfig, which ~/.config/git/config includes. The
# tinted-delta item sets only the syntax theme, so delta would otherwise
# draw its stock red and green backgrounds under every scheme. Line
# backgrounds blend the scheme's red and green into its background.

set -q TINTY_SCHEME_PALETTE_BASE00_RGB_R; or exit 0

set -l data_home ~/.local/share
set -q XDG_DATA_HOME; and set data_home $XDG_DATA_HOME
set -l out $data_home/tinted-theming/tinty/delta-colors.gitconfig

# Prints base<name> as #rrggbb.
function _hex -a name
    set -l hex
    for c in R G B
        set -l v TINTY_SCHEME_PALETTE_BASE{$name}_HEX_$c
        set -a hex $$v
    end
    printf '#%s%s%s' $hex
end

# Prints base<name> mixed into the background at the given ratio.
function _mix -a name ratio
    set -l rgb
    for c in R G B
        set -l bg TINTY_SCHEME_PALETTE_BASE00_RGB_$c
        set -l fg TINTY_SCHEME_PALETTE_BASE{$name}_RGB_$c
        set -a rgb (math "round($$bg + ($$fg - $$bg) * $ratio)")
    end
    printf '#%02x%02x%02x' $rgb
end

# Line numbers and rules use the foreground at a contrast that stays
# readable on light and dark schemes.
set -l muted (_mix 05 0.45)
set -l red (_hex 08)
set -l green (_hex 0B)
set -l blue (_hex 0D)

# map-styles recolors the lines that git's diff.colorMoved marks as moved.
printf '%s\n' \
    '# Written by the delta tinty hook. Changes are lost on `theme`.' \
    '[delta]' \
    "	minus-style = syntax \"$(_mix 08 0.13)\"" \
    "	minus-emph-style = syntax \"$(_mix 08 0.28)\"" \
    "	plus-style = syntax \"$(_mix 0B 0.13)\"" \
    "	plus-emph-style = syntax \"$(_mix 0B 0.28)\"" \
    "	map-styles = \"bold purple => syntax $(_mix 0E 0.18), bold cyan => syntax $(_mix 0C 0.18)\"" \
    "	line-numbers-minus-style = \"$red\"" \
    "	line-numbers-plus-style = \"$green\"" \
    "	line-numbers-zero-style = \"$muted\"" \
    "	line-numbers-left-style = \"$muted\"" \
    "	line-numbers-right-style = \"$muted\"" \
    "	file-style = bold \"$blue\"" \
    "	file-decoration-style = \"$muted\" ul" \
    "	hunk-header-decoration-style = \"$muted\" box" \
    "	hunk-header-line-number-style = \"$muted\"" >$out
