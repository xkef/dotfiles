brew "nono"                 # capability-based sandbox for AI agents
brew "ccusage"              # Claude Code usage analyzer
brew "lima"                 # Linux dev VMs (~/.config/lima/dev.yaml)
brew "openssl@3"            # the CA for the Lima VM proxy, which LibreSSL keys fail
brew "lua-language-server"  # Lua LSP for the Claude Code lua-lsp plugin
brew "typescript-language-server" # TypeScript LSP for the typescript-lsp plugin
brew "jdtls"                # Java LSP for the Claude Code jdtls-lsp plugin
