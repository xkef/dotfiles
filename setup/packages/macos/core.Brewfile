tap "libkrun/krun", trusted: true # krunkit
brew "git"                  # version control
brew "less"                 # pager (used as $PAGER)
brew "gh"                   # GitHub from the command line
brew "jq"                   # JSON processor
brew "age"                  # simple file encryption
brew "fish"                 # shell
brew "starship"             # cross-shell prompt
brew "atuin"                # shell history search/sync
brew "fzf"                  # fuzzy finder (yazi's z key)
brew "television"           # fuzzy finder with channels
brew "zoxide"               # smarter cd with frecency
brew "tmux"                 # terminal multiplexer
brew "sesh"                 # tmux session manager
brew "neovim"               # text editor
brew "tree-sitter-cli"      # parser generator CLI (nvim-treesitter build)
brew "presenterm"           # markdown-driven terminal slides
brew "eza"                  # modern ls replacement
brew "bat"                  # cat with syntax highlighting
brew "fd"                   # modern find replacement
brew "ripgrep"              # fast recursive grep
brew "xh"                   # fast HTTP client (HTTPie-compatible)
brew "hurl"                 # HTTP request testing with plain text files
brew "sd"                   # intuitive find-and-replace (sed alt)
brew "dust"                 # disk usage viewer (du alt)
brew "duf"                  # disk free viewer (df alt)
brew "procs"                # modern ps replacement
brew "ouch"                 # compress/decompress archives
brew "delta"                # syntax-highlighting diff pager
brew "difftastic"           # structural diff tool
brew "lazygit"              # terminal UI for git
brew "jj"                   # Jujutsu version control
brew "jjui"                 # terminal UI for jj
brew "mise"                 # dev tool version manager
brew "dotter"               # dotfile manager (links this repo into ~)
brew "rustup"               # Rust toolchain manager (keg-only, PATH in env.fish)
brew "go"                   # Go (go.mod pins newer toolchains)
brew "uv"                   # Python package and version manager
brew "python"               # Python for scripts outside projects
brew "node"                 # Node.js for npx outside projects
brew "rumdl"                # markdown linter and formatter (LazyVim, with a rumdl config)
brew "dprint"               # formatter (LazyVim, with a dprint config)
brew "podman"               # rootless container engine
brew "docker-compose"       # compose provider for podman compose
brew "libkrun/krun/krunkit" # libkrun VM runner for podman machine
brew "skopeo"               # registry image inspection (imgarch)
brew "lazydocker"           # terminal UI for Docker/Podman
brew "fx"                   # terminal JSON viewer
brew "scooter"              # interactive find-and-replace TUI
brew "yazi"                 # terminal file manager
brew "glow"                 # terminal markdown renderer
brew "vale"                 # prose linter for markdown
brew "tokei"                # code statistics by language
brew "tealdeer"             # fast tldr client
brew "htop"                 # interactive process viewer
brew "hyperfine"            # command-line benchmarking
brew "bandwhich"            # per-process bandwidth monitor
brew "xdg-ninja"            # audit XDG base-dir compliance
