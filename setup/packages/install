#!/usr/bin/env bash
# Installs the packages this repo lists: Homebrew on macOS, pacman and paru
# on Arch. Other systems install nothing. Each module has its own list,
# such as macos/agents.Brewfile or arch/agents.txt, and only the modules
# in DOTFILES_PACKAGES install. setup/apply sets it to the selected ones,
# such as "agents core". CI skips desktop, the GUI apps.
#
# Each run checks the lists first and installs only what is missing. A
# failed Arch package or macOS cask doesn't stop the others, and the
# next run retries it. A failed formula stops the run.
set -euo pipefail
cd "$(dirname "$0")"

modules=()
for module in ${DOTFILES_PACKAGES:-core}; do
  if [[ "$module" == desktop && "${CI:-}" == true ]]; then
    continue
  fi
  modules+=("$module")
done

# Prints a package list without its comments.
list() {
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$1"
}

install_darwin() {
  if ! command -v brew >/dev/null; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      [[ -x "$brew_bin" ]] && eval "$("$brew_bin" shellenv)" && break
    done
  fi

  local module brewfile
  split=$(mktemp -d "${TMPDIR:-/tmp}/packages.XXXXXX")
  trap 'rm -rf "$split"' EXIT
  for module in "${modules[@]}"; do
    brewfile=macos/$module.Brewfile
    if [[ ! -f "$brewfile" ]] || brew bundle check --file="$brewfile" >/dev/null; then
      continue
    fi

    # Formulae must install, and casks fail soft. Self-updating GUI apps
    # such as zed and 1password hit stale-receipt and quarantine issues that
    # must not block the apply.
    list "$brewfile" | { grep -v '^cask ' || :; } >"$split/$module.formulae.Brewfile"
    list "$brewfile" | { grep '^cask ' || :; } >"$split/$module.casks.Brewfile"
    brew bundle --file="$split/$module.formulae.Brewfile"
    if [[ -s "$split/$module.casks.Brewfile" ]] &&
      ! brew bundle --file="$split/$module.casks.Brewfile"; then
      echo "warning: some casks failed; the next apply retries them" >&2
    fi
  done

  # Homebrew keeps rustup keg-only.
  local rustup_bin
  rustup_bin="$(brew --prefix)/opt/rustup/bin"
  if [[ -x "$rustup_bin/rustup" ]]; then
    PATH="$rustup_bin:$PATH" ensure_toolchain
  fi
}

# Returns 0 only if paru exists and runs. A paru binary breaks when pacman
# ships a newer libalpm than the one it linked against.
paru_works() {
  command -v paru >/dev/null && paru --version >/dev/null 2>&1
}

# Builds paru from source so it links the installed libalpm. The prebuilt
# paru-bin lags behind pacman and conflicts with paru, so it goes first.
ensure_paru() {
  paru_works && return 0
  local tmpdir
  tmpdir="$(mktemp -d)"
  sudo pacman -S --needed --noconfirm base-devel
  if pacman -Q paru-bin >/dev/null 2>&1; then
    sudo pacman -Rdd --noconfirm paru-bin
  fi
  git clone https://aur.archlinux.org/paru.git "$tmpdir/paru"
  (cd "$tmpdir/paru" && makepkg -si --noconfirm)
  rm -rf "$tmpdir"
  paru_works
}

# Installs rustup with a stable default so it provides cargo. Otherwise
# builds that need cargo, such as paru's, pull in rust under --noconfirm,
# and rust conflicts with rustup. An installed rust goes first.
ensure_rustup() {
  if ! pacman -Q rustup >/dev/null 2>&1; then
    if pacman -Q rust >/dev/null 2>&1; then
      sudo pacman -Rdd --noconfirm rust
    fi
    sudo pacman -S --noconfirm rustup
  fi
  ensure_toolchain
}

# Installs stable with rust-analyzer and rust-src and makes it the default
# unless one is set. Editors run rust-analyzer from stable for every
# project. The toolchain goes where env.fish points RUSTUP_HOME, even from
# bash.
ensure_toolchain() {
  export RUSTUP_HOME="${RUSTUP_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/rustup}"
  rustup toolchain install stable --no-self-update \
    --component rust-analyzer --component rust-src
  rustup default >/dev/null 2>&1 || rustup default stable
}

install_arch() {
  local packages=() module pkg
  for module in "${modules[@]}"; do
    if [[ -f arch/$module.txt ]]; then
      mapfile -t -O "${#packages[@]}" packages < <(list "arch/$module.txt")
    fi
  done

  # pacman -T fails when a package is missing. Without one, the install
  # needs neither sudo nor a sync.
  if pacman -T "${packages[@]}" >/dev/null; then
    return
  fi

  sudo -v
  sudo pacman -Syu --noconfirm
  ensure_rustup
  if ! ensure_paru; then
    echo "warning: paru unusable; installing repo packages via pacman, AUR skipped" >&2
    for pkg in "${packages[@]}"; do
      sudo pacman -S --needed --noconfirm "$pkg" ||
        echo "warning: $pkg not in official repos (AUR?), skipped" >&2
    done
    return
  fi

  local paru_flags=(--needed --noconfirm)
  [[ -e /mnt/lima-cidata ]] && paru_flags+=(--mflags="-A")
  # One broken AUR package must not abort the whole apply. Retry one by
  # one and skip the failures with a warning.
  if ! paru -S "${paru_flags[@]}" "${packages[@]}"; then
    echo "warning: batch install failed; retrying packages individually" >&2
    for pkg in "${packages[@]}"; do
      if ! paru -S "${paru_flags[@]}" "$pkg"; then
        echo "warning: $pkg failed to install, skipped" >&2
      fi
    done
  fi
}

case "$(uname -s)" in
Darwin)
  install_darwin
  ;;
Linux)
  # shellcheck source=/dev/null
  . /etc/os-release
  if [[ "$ID" == arch || "$ID" == archarm ]]; then
    install_arch
  fi
  ;;
esac
