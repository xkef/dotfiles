#!/usr/bin/env bash
# Writes the git, jj, and SSH identity. Each identity reads its fields from
# ~/.config/identity/<vault>, one key=value per line, or else from the
# SSH Key item `git` in that 1Password vault:
#
#   name=Ada Lovelace
#   email=ada@example.com
#   public_key=ssh-ed25519 AAAA...
#
# Personal is required. Work, which also holds noreply_email and
# github_login, is optional. Without either source, nothing renders.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}"
git_dir="$config/git"
jj_dir="$config/jj/conf.d"

has() {
  [[ -f "$config/identity/$1" ]] ||
    { command -v op >/dev/null && op vault get "$1" >/dev/null 2>&1; }
}

field() {
  local value
  if [[ -f "$config/identity/$1" ]]; then
    value=$(sed -n "s/^$2=//p" "$config/identity/$1")
  else
    value=$(op read "op://$1/git/${2/public_key/public key}")
  fi
  if [[ -z "$value" ]]; then
    echo "identity: $1 has no $2" >&2
    return 1
  fi
  printf '%s' "$value"
}

if ! has Personal; then
  echo "identity: no Personal identity, skipping" >&2
  exit 0
fi

name=$(field Personal name)
email=$(field Personal email)
key=$(field Personal public_key)
mkdir -p "$git_dir" "$jj_dir" "$HOME/.ssh"

printf '%s\n' "$key" >"$HOME/.ssh/github.pub"
printf '%s namespaces="git" %s\n' "$email" "$key" >"$git_dir/allowed_signers"

cat >"$git_dir/config.personal" <<CONF
[user]
	name = $name
	email = $email
	signingkey = key::$key
CONF

cat >"$jj_dir/identity.toml" <<CONF
[user]
name = "$name"
email = "$email"

[signing]
behavior = "own"
backend = "ssh"
key = "$key"
CONF

if ! has Work; then
  exit 0
fi

name=$(field Work name)
email=$(field Work email)
noreply=$(field Work noreply_email)
login=$(field Work github_login)
key=$(field Work public_key)

printf '%s namespaces="git" %s\n' "$noreply" "$key" >>"$git_dir/allowed_signers"

# The [includeIf] in the git config activates this inside ~/work/ only.
cat >"$git_dir/config.work" <<CONF
[user]
	name = $name
	email = $email

[commit]
	gpgsign = false

[tag]
	gpgsign = false
CONF

cat >"$jj_dir/work.toml" <<CONF
[[--scope]]
--when.repositories = ["~/work"]
[--scope.user]
name = "$name"
email = "$email"
[--scope.signing]
behavior = "drop"
CONF

# Secondary GitHub identity for the Work account's repos, matched by
# remote URL. The SSH agent serves its signing key.
cat >"$git_dir/config.secondary" <<CONF
[user]
	name = $name
	email = $noreply
	signingkey = key::$key
CONF

cat >"$git_dir/config.secondary-remotes" <<CONF
[includeIf "hasconfig:remote.*.url:https://github.com/$login/**"]
	path = ~/.config/git/config.secondary

[includeIf "hasconfig:remote.*.url:git@github.com:$login/**"]
	path = ~/.config/git/config.secondary
CONF
