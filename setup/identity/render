#!/usr/bin/env bash
# Renders the git and jj identity from 1Password with `op inject`, which
# fails on any unreadable reference instead of writing an empty value. The
# plain git and jj configs hold the public fallback that these files
# override. Pass `true` to render the work identity too.
#
# Usage: setup/identity/render [true|false]
set -euo pipefail
cd "$(dirname "$0")"

git_dir="${XDG_CONFIG_HOME:-$HOME/.config}/git"
jj_dir="${XDG_CONFIG_HOME:-$HOME/.config}/jj/conf.d"
readonly public_signer='git@xkef.dev namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFXPTYbJpNsexhTZ+x8Ci8tVkGV/d0MvWqFrlyT3yTki'
mkdir -p "$git_dir" "$jj_dir"

if ! command -v op >/dev/null; then
  printf '%s\n' "$public_signer" >"$git_dir/allowed_signers"
  exit 0
fi

render() {
  op inject --force --in-file "$1" --out-file "$2" >/dev/null
}

render git/allowed_signers "$git_dir/allowed_signers"
render git/config.personal "$git_dir/config.personal"
render git/config.secondary "$git_dir/config.secondary"
render git/config.secondary-remotes "$git_dir/config.secondary-remotes"
render jj/identity.toml "$jj_dir/identity.toml"

if [[ "${1:-}" == true ]]; then
  render git/config.work "$git_dir/config.work"
  render jj/work.toml "$jj_dir/work.toml"
fi
