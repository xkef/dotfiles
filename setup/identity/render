#!/usr/bin/env bash
# Writes the git, jj, and SSH identity. Personal and Work take the same
# fields, from ~/.config/identity/<name>, one key=value per line, or else
# from the SSH Key item `git` in the 1Password vault of that name:
#
#   name=Ada Lovelace
#   email=ada@example.com
#   public_key=ssh-ed25519 AAAA...
#   github_login=ada                              optional
#   noreply_email=1+ada@users.noreply.github.com  optional
#
# Personal is the default everywhere, and without it nothing renders. Work
# is optional and applies inside ~/work. With a github_login, Work also
# signs commits to that account's GitHub repos, as noreply_email or else
# email. Personal ignores the two optional fields. An empty
# ~/.config/identity/no-work turns Work off.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}"
git_dir="$config/git"
jj_dir="$config/jj/conf.d"

has() {
  [[ -f "$config/identity/$1" ]] ||
    { command -v op >/dev/null && op vault get "$1" >/dev/null 2>&1; }
}

# Prints a field, or nothing when it's missing.
optional() {
  if [[ -f "$config/identity/$1" ]]; then
    sed -n "s/^$2=//p" "$config/identity/$1"
  else
    op read "op://$1/git/${2/public_key/public key}" 2>/dev/null || true
  fi
}

field() {
  local value
  value=$(optional "$1" "$2")
  if [[ -z "$value" ]]; then
    echo "identity: $1 has no $2" >&2
    return 1
  fi
  printf '%s' "$value"
}

if ! has Personal; then
  echo "identity: no Personal identity, skipping" >&2
  exit 0
fi

name=$(field Personal name)
email=$(field Personal email)
key=$(field Personal public_key)
mkdir -p "$git_dir" "$jj_dir" "$HOME/.ssh"

printf '%s\n' "$key" >"$HOME/.ssh/github.pub"
printf '%s namespaces="git" %s\n' "$email" "$key" >"$git_dir/allowed_signers"

cat >"$git_dir/config.personal" <<CONF
[user]
	name = $name
	email = $email
	signingkey = key::$key
CONF

cat >"$jj_dir/identity.toml" <<CONF
[user]
name = "$name"
email = "$email"

[signing]
behavior = "own"
backend = "ssh"
key = "$key"
CONF

# no-work wins over a Work vault that 1Password still shows, and removes
# the files an earlier render wrote.
if [[ -f "$config/identity/no-work" ]]; then
  rm -f "$git_dir/config.work" "$git_dir/config.secondary" \
    "$git_dir/config.secondary-remotes" "$jj_dir/work.toml"
  exit 0
fi

if ! has Work; then
  exit 0
fi

name=$(field Work name)
email=$(field Work email)
key=$(field Work public_key)
login=$(optional Work github_login)
noreply=$(optional Work noreply_email)
noreply=${noreply:-$email}

# The [includeIf] in the git config activates this inside ~/work/ only.
cat >"$git_dir/config.work" <<CONF
[user]
	name = $name
	email = $email

[commit]
	gpgsign = false

[tag]
	gpgsign = false
CONF

cat >"$jj_dir/work.toml" <<CONF
[[--scope]]
--when.repositories = ["~/work"]
[--scope.user]
name = "$name"
email = "$email"
[--scope.signing]
behavior = "drop"
CONF

# Secondary GitHub identity for the Work account's repos, matched by
# remote URL. The SSH agent serves its signing key.
if [[ -z "$login" ]]; then
  rm -f "$git_dir/config.secondary" "$git_dir/config.secondary-remotes"
  exit 0
fi

printf '%s namespaces="git" %s\n' "$noreply" "$key" >>"$git_dir/allowed_signers"

cat >"$git_dir/config.secondary" <<CONF
[user]
	name = $name
	email = $noreply
	signingkey = key::$key
CONF

cat >"$git_dir/config.secondary-remotes" <<CONF
[includeIf "hasconfig:remote.*.url:https://github.com/$login/**"]
	path = ~/.config/git/config.secondary

[includeIf "hasconfig:remote.*.url:git@github.com:$login/**"]
	path = ~/.config/git/config.secondary
CONF
