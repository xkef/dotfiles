# Secondary GitHub identity. config.secondary-remotes activates it by remote
# URL. The SSH agent serves the signing key from the 1Password Work vault.

[user]
	name = {{ op://Work/git/name }}
	email = {{ op://Work/git/noreply_email }}
	signingkey = key::{{ op://Work/4iwi4zirnfsx643om5beg2y5ua/public key }}
