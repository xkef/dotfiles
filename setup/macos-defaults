#!/usr/bin/env bash
# macOS developer defaults. setup/onchange reruns it when this file
# changes. Curated from mathiasbynens/dotfiles, wincent/wincent, and
# paulirish/dotfiles.
#
# Usage:
#   ./macos-defaults               Apply all settings
#   ./macos-defaults --dry-run     Show what would change
set -euo pipefail

if [[ "$(uname -s)" != Darwin ]]; then
  echo "This script is macOS-only." >&2
  exit 1
fi

DRY_RUN=false
[[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]] && DRY_RUN=true

log() { printf '  %s\n' "$1"; }

changed=0
skipped=0
missing=0

TMP_DOMAIN="com.dotfiles.macos-defaults-check"

# Prints the current value of a defaults entry, or nothing when unset.
read_default() {
  local flag="" domain key
  if [[ "$1" == "-currentHost" ]]; then
    flag="-currentHost"
    domain="$2"
    key="$3"
  else
    domain="$1"
    key="$2"
  fi
  defaults $flag read "$domain" "$key" 2>/dev/null || true
}

# Normalizes a value to the format `defaults read` returns by round-tripping
# it through a scratch domain.
normalize() {
  local type="$1" value="$2"
  defaults write "$TMP_DOMAIN" __check "$type" "$value" 2>/dev/null
  defaults read "$TMP_DOMAIN" __check 2>/dev/null || echo "$value"
  defaults delete "$TMP_DOMAIN" __check &>/dev/null || true
}

# Applies or diffs one defaults entry.
# Usage: apply [-currentHost] domain key -type value
apply() {
  local flag="" domain key type value
  if [[ "$1" == "-currentHost" ]]; then
    flag="-currentHost"
    shift
  fi
  domain="$1"
  key="$2"
  type="$3"
  value="$4"

  if $DRY_RUN; then
    local current expected
    current=$(read_default $flag "$domain" "$key")
    expected=$(normalize "$type" "$value")

    if [[ -z "$current" ]]; then
      printf '  \033[33m+\033[0m %s %s \033[2m(not set -> %s)\033[0m\n' "$domain" "$key" "$value"
      ((missing++)) || true
      return
    fi

    # Normalize booleans
    if [[ "$type" == "-bool" ]]; then
      [[ "$current" == "1" || "$current" == "true" ]] && current="1" || current="0"
      [[ "$expected" == "1" || "$expected" == "true" ]] && expected="1" || expected="0"
    fi

    if [[ "$current" != "$expected" ]]; then
      printf '  \033[31m~\033[0m %s %s \033[2m(%s -> %s)\033[0m\n' "$domain" "$key" "$current" "$value"
      ((changed++)) || true
    else
      ((skipped++)) || true
    fi
  else
    defaults $flag write "$domain" "$key" "$type" "$value"
  fi
}

# Prints each element of a defaults array, one per line.
read_array() {
  defaults read "$1" "$2" 2>/dev/null |
    sed -e '1d;$d' -e 's/^ *//' -e 's/,$//' -e 's/^"\(.*\)"$/\1/' || true
}

# Applies or diffs a defaults array of strings.
# Usage: apply_array domain key value...
apply_array() {
  local domain="$1" key="$2"
  shift 2

  if ! $DRY_RUN; then
    defaults write "$domain" "$key" -array "$@"
    return
  fi

  if [[ "$(read_array "$domain" "$key")" == "$(printf '%s\n' "$@")" ]]; then
    ((skipped++)) || true
    return
  fi
  printf '  \033[31m~\033[0m %s %s \033[2m(%d items)\033[0m\n' "$domain" "$key" "$#"
  ((changed++)) || true
}

if $DRY_RUN; then
  printf '\n  macOS defaults (dry run)\n\n'
else
  printf '\n  Applying macOS defaults...\n\n'
  osascript -e 'tell application id "com.apple.systempreferences" to quit' 2>/dev/null || true
  # Mail and Calendar cache their settings and ignore writes while open.
  for app in com.apple.mail com.apple.iCal; do
    osascript -e "if application id \"$app\" is running then tell application id \"$app\" to quit" 2>/dev/null || true
  done
  sudo -v
  while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
  done 2>/dev/null &
fi

# ── Typing and input ──────────────────────────────────

$DRY_RUN || log "Typing & input..."
apply NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
apply NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
apply NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
apply NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
apply NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
apply NSGlobalDomain ApplePressAndHoldEnabled -bool false
apply NSGlobalDomain KeyRepeat -int 2
apply NSGlobalDomain InitialKeyRepeat -int 15
apply NSGlobalDomain AppleKeyboardUIMode -int 3
apply NSGlobalDomain TSMLanguageIndicatorEnabled -bool false
apply NSGlobalDomain NSAutomaticInlinePredictionEnabled -bool false
apply NSGlobalDomain AppleICUForce24HourTime -bool true
apply NSGlobalDomain AppleLocale -string "en_US@rg=chzzzz"

# CapsLock to Escape, persisted through a hidutil LaunchAgent.
HIDUTIL_PLIST="$HOME/Library/LaunchAgents/com.local.KeyRemapping.plist"
if $DRY_RUN; then
  if [[ -f "$HIDUTIL_PLIST" ]]; then
    ((skipped++)) || true
  else
    printf '  \033[33m+\033[0m %s \033[2m(CapsLock -> Escape via hidutil LaunchAgent)\033[0m\n' "$HIDUTIL_PLIST"
    ((missing++)) || true
  fi
else
  mkdir -p "$HOME/Library/LaunchAgents"
  cat >"$HIDUTIL_PLIST" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.KeyRemapping</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x700000029}]}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
PLIST
  # hidutil needs real HID access. Tolerate failure on headless CI runners.
  hidutil property --set '{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x700000029}]}' >/dev/null ||
    [[ "${CI:-}" == true ]]
fi

# ── Appearance ────────────────────────────────────────

$DRY_RUN || log "Appearance..."
