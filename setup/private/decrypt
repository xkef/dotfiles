#!/usr/bin/env bash
# Decrypts private/home.tar.age, an archive of files under $HOME, into
# $HOME with the age key in 1Password. One archive keeps the file names
# out of the public repo. `mise run encrypt <file>` adds a file to it.
# Without op, age, or the key, it decrypts nothing.
set -euo pipefail
umask 077

key_ref="op://Dev/dotfiles-age-key/password"
archive="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/private/home.tar.age"

if ! command -v op >/dev/null || ! command -v age >/dev/null; then
  echo "private: op or age not found, skipping" >&2
  exit 0
fi
if ! key=$(op read "$key_ref" 2>/dev/null); then
  echo "private: no age key at $key_ref, skipping" >&2
  exit 0
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/private.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
age --decrypt --identity <(printf '%s\n' "$key") "$archive" | tar -xzf - -C "$tmp"

cd "$tmp"
find . -type f | while IFS= read -r file; do
  target="$HOME/${file#./}"

  # A plaintext newer than its archived copy holds edits not yet
  # encrypted. The archive keeps each file's mtime, and decrypt copies it.
  if [[ "$target" -nt "$file" ]]; then
    echo "private: skipped $target, newer than its archived copy; run mise run encrypt" >&2
    continue
  fi

  mkdir -p "${target%/*}"
  cp "$file" "$target"
  chmod 600 "$target"
  touch -r "$file" "$target"
done
