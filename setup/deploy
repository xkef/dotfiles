#!/usr/bin/env bash
# Deploys the repo into $HOME with dotter. The dotter config and hooks live
# in setup/dotter, so a plain `dotter deploy` doesn't find them. The local
# config and the cache live in ~/.local/state/dotter, not in the repo,
# because a Lima VM mounts the same checkout. The first run writes a local
# config that selects every package, or core and agents inside a VM. Edit
# the packages list in ~/.local/state/dotter/local.toml to change the
# selection. Arguments pass through to dotter, as in
# `setup/deploy --dry-run`.
#
# Homebrew and pacman install dotter from the package lists. The first
# deploy runs before them, so it downloads a pinned release.
set -euo pipefail
cd "$(dirname "$0")/.."

readonly release=https://github.com/SuperCuber/dotter/releases/download/v0.13.5
state="${XDG_STATE_HOME:-$HOME/.local/state}/dotter"

mkdir -p "$state"
packages='"core", "desktop", "agents"'
if systemd-detect-virt -q 2>/dev/null; then
  packages='"core", "agents"'
fi
if [[ ! -f "$state/local.toml" ]]; then
  printf 'packages = [%s]\n' "$packages" >"$state/local.toml"
fi

# Migrates a machine from before the split into packages, and from before
# the agent settings left dotter. Dotter keeps the old settings templates
# in its cache and fails every deploy trying to delete the files the
# agents changed. The files stay, owned by the agents.
if grep -qxF 'packages = ["dotfiles"]' "$state/local.toml"; then
  printf 'packages = [%s]\n' "$packages" >"$state/local.toml"
fi
if [[ -f "$state/cache.toml" ]]; then
  grep -vE '^"home/agents/(claude|pi)/settings\.json" = ".*/settings\.json"$' \
    "$state/cache.toml" >"$state/cache.toml.new" || true
  mv -f "$state/cache.toml.new" "$state/cache.toml"
fi

# Dotter skips a link whose target already exists. A ~/.npmrc that holds
# only the cooldown makes way for the linked one.
if [[ -f ~/.npmrc && ! -L ~/.npmrc && "$(cat ~/.npmrc)" == "min-release-age=7" ]]; then
  rm ~/.npmrc
fi

dotter=$(command -v dotter || true)
if [[ -z "$dotter" ]]; then
  case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) asset="dotter-macos-arm64.arm" ;;
  Linux-x86_64) asset="dotter-linux-x64-musl" ;;
  Linux-aarch64) asset="dotter-linux-arm64-musl" ;;
  *)
    echo "no dotter release for $(uname -sm)" >&2
    exit 1
    ;;
  esac
  dotter="$state/dotter"
  curl -fsSL "$release/$asset" -o "$dotter"
  chmod +x "$dotter"
fi

"$dotter" --global-config setup/dotter/global.toml \
  --pre-deploy setup/dotter/pre_deploy.sh --post-deploy setup/dotter/post_deploy.sh \
  --local-config "$state/local.toml" \
  --cache-file "$state/cache.toml" --cache-directory "$state/cache" \
  "$@" deploy
