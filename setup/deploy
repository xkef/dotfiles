#!/usr/bin/env bash
# Deploys the repo into $HOME with dotter. The dotter config and hooks live
# in setup/dotter, so a plain `dotter deploy` doesn't find them. The local
# config and the cache live in ~/.local/state/dotter, not in the repo,
# because a Lima VM mounts the same checkout. The first run writes a local
# config that selects core, desktop, and agents, or core and agents inside
# a VM. Extras such as wezterm go in the packages list in
# ~/.local/state/dotter/local.toml by hand. Arguments pass through to dotter, as in
# `setup/deploy --dry-run`.
#
# Homebrew and paru install dotter from the package lists. The first
# deploy runs before them, so it downloads the release that mise.lock pins
# and checks it against the locked sha256.
set -euo pipefail
cd "$(dirname "$0")/.."

state="${XDG_STATE_HOME:-$HOME/.local/state}/dotter"

mkdir -p "$state"
packages='"core", "desktop", "agents"'
if systemd-detect-virt -q 2>/dev/null; then
  packages='"core", "agents"'
fi
if [[ ! -f "$state/local.toml" ]]; then
  printf 'packages = [%s]\n' "$packages" >"$state/local.toml"
fi

# Prints one field of the dotter entry for a platform in mise.lock.
locked() {
  awk -v section="[tools.\"github:SuperCuber/dotter\".\"platforms.$1\"]" -v key="$2" '
    $0 == section { found = 1; next }
    /^\[/ { found = 0 }
    found && $1 == key { gsub(/"/, "", $3); print $3 }
  ' mise.lock
}

dotter=$(command -v dotter || true)
if [[ -z "$dotter" ]]; then
  case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) platform=macos-arm64 ;;
  Linux-x86_64) platform=linux-x64 ;;
  Linux-aarch64) platform=linux-arm64 ;;
  *)
    echo "no dotter release for $(uname -sm)" >&2
    exit 1
    ;;
  esac
  dotter="$state/dotter"
  curl -fsSL "$(locked "$platform" url)" -o "$dotter"
  # Arch lacks the Perl shasum, and older macOS lacks sha256sum.
  sum=$(sha256sum "$dotter" 2>/dev/null || shasum -a 256 "$dotter")
  if [[ "sha256:${sum%% *}" != "$(locked "$platform" checksum)" ]]; then
    rm -f "$dotter"
    echo "dotter download fails the mise.lock checksum" >&2
    exit 1
  fi
  chmod +x "$dotter"
fi

"$dotter" --global-config setup/dotter/global.toml \
  --pre-deploy setup/dotter/pre_deploy.sh --post-deploy setup/dotter/post_deploy.sh \
  --local-config "$state/local.toml" \
  --cache-file "$state/cache.toml" --cache-directory "$state/cache" \
  "$@" deploy
