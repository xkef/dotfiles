#!/usr/bin/env bash
# Sets up a new machine. setup/apply needs fish, which a new machine
# lacks, so this installs the core package list first, which brings fish
# and the package manager. `dots apply` runs setup/apply afterwards.
set -euo pipefail
cd "$(dirname "$0")/.."

# The calling shell predates Homebrew. Put the install prefixes first so
# later steps find the tools the packages step installs.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
# A new machine has no fish environment yet. Tools such as brew fall back
# to ~/Library/Application Support on macOS without it.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

DOTFILES_PACKAGES=core setup/packages/install
exec fish --no-config setup/apply "$@"
