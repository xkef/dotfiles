#!/usr/bin/env bash
# Publishes coding-agent state to the terminal. The Claude Code hook, the
# agent launchers, and agents publishing a task summary all write through
# this script, so the format lives in one place.
#
#   agent-state set <agent> <state> [detail]
#   agent-state task <summary>
#   agent-state clear
#
# Each command writes OSC 1337 SetUserVar sequences to the controlling
# terminal. WezTerm stores the vars with the pane, and
# ~/.config/wezterm/agents.lua reads them for the status line and the agent
# picker. The state dies with the pane, so nothing needs cleanup. Outside
# WezTerm, or without a terminal, the commands do nothing.
set -euo pipefail

readonly MAX_TASK_LENGTH=60

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

# Sets each name=value pair in one write, so the sequences reach the
# terminal together.
set_vars() {
  local seq="" name value
  while [ $# -ge 2 ]; do
    name=$1 value=$2
    shift 2
    seq+=$(printf '\033]1337;SetUserVar=%s=%s\007' "$name" "$(printf '%s' "$value" | base64 | tr -d '\n')")
  done
  { printf '%s' "$seq" >/dev/tty; } 2>/dev/null || true
}

cmd=${1:-}
[ -n "$cmd" ] || usage
shift

[ -n "${WEZTERM_PANE:-}" ] || exit 0

case "$cmd" in
set)
  [ $# -ge 2 ] || usage
  case "$2" in
  idle | busy | waiting) ;;
  *)
    echo "agent-state: unknown state '$2'" >&2
    exit 2
    ;;
  esac
  set_vars agent "$1" agent_state "$2" agent_detail "${3:-}"
  ;;
task)
  [ $# -ge 1 ] || exit 0
  summary=$*
  set_vars agent_task "${summary:0:MAX_TASK_LENGTH}"
  ;;
clear)
  set_vars agent "" agent_state "" agent_detail "" agent_task ""
  ;;
*) usage ;;
esac
