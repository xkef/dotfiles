#!/usr/bin/env fish
# theme: switches the color scheme of WezTerm, Neovim, and delta through
# tinty, configured in ~/.config/tinted-theming/tinty/config.toml.
#
# Usage:
#   theme            Pick a scheme with fzf
#   theme <scheme>   Apply a scheme, such as base16-catppuccin-mocha
#   theme --current  Print the current scheme
#   theme --list     List the schemes

switch "$argv[1]"
    case --current
        tinty current
    case --list -l
        tinty list
    case --help -h
        sed -n 's/^#   //p' (status filename)
    case ''
        set -l scheme (tinty list | fzf --prompt 'theme> ' --query (tinty current 2>/dev/null)); or return
        tinty apply $scheme
    case '*'
        tinty apply $argv[1]
end
