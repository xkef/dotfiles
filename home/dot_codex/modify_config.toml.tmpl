#!/usr/bin/env bash
# Merge the tracked Codex config over whatever Codex has written locally.
#
# Codex owns config.toml at runtime: the model picker, the reasoning-effort
# picker, and the permission and memories screens all write back to it.
# Managing the file outright would drop that state on every apply, so this
# re-asserts the committed keys and leaves the rest of the file alone.
#
# Filter managed keys only in their own table, preserving runtime settings.
# The status line can span multiple lines after a TOML formatter runs.
set -euo pipefail

readonly HEADER='# Managed by chezmoi. Edit home/dot_codex/modify_config.toml.tmpl instead.'
readonly MANAGED_KEYS='model_reasoning_effort|approval_policy|sandbox_mode|notify|service_tier|approvals_reviewer'
readonly TUI_KEYS='status_line|status_line_use_colors'

managed=$(
  printf '%s\n' "$HEADER"
  cat <<'MANAGED_TOML'
model_reasoning_effort = "xhigh"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
service_tier = "default"
approvals_reviewer = "auto_review"
MANAGED_TOML
  # Codex runs the notify command directly, so the path cannot rely on a shell
  # expanding a tilde or on ~/.local/bin being on PATH.
  printf 'notify = ["%s/.local/bin/codex-notify"]\n' '{{ .chezmoi.homeDir }}'
)

tui=$(
  cat <<'TUI_TOML'
status_line = [
  "model-with-reasoning",
  "context-used",
  "weekly-limit",
  "context-window-size",
  "fast-mode",
  "git-branch",
  "five-hour-limit",
  "estimated-thread-cost",
]
status_line_use_colors = true
TUI_TOML
)

local_config=$(cat)

printf '%s\n' "$managed"

printf '%s' "$local_config" | CODEX_MANAGED_TUI="$tui" awk \
  -v keys="$MANAGED_KEYS" -v header="$HEADER" -v tui_keys="$TUI_KEYS" '
  BEGIN { tui = ENVIRON["CODEX_MANAGED_TUI"] }
  skip_array {
    if ($0 ~ /\]/) { skip_array = 0 }
    next
  }
  /^[[:space:]]*\[/ {
    in_table = 1
    in_tui = $0 ~ /^[[:space:]]*\[tui\][[:space:]]*(#.*)?$/
    print
    if (in_tui) {
      print tui
      has_tui = 1
    }
    next
  }
  in_tui && $0 ~ "^[[:space:]]*(" tui_keys ")[[:space:]]*=" {
    skip_array = $0 ~ /\[/ && $0 !~ /\]/
    next
  }
  in_table { print; next }
  $0 == header { next }
  $0 ~ "^[[:space:]]*(" keys ")[[:space:]]*=" { next }
  { print }
  END {
    if (!has_tui) { printf "\n[tui]\n%s\n", tui }
  }
'
