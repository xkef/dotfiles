{{ if lookPath "mise" -}}
#!/bin/bash
set -euo pipefail
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
mise trust 2>/dev/null || true
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64") -}}
# aqua ships no maven-mvnd build for linux/arm64
export MISE_DISABLE_TOOLS=mvnd
{{ end -}}
mise install
{{ end -}}
