{{ if lookPath "vale" -}}
#!/bin/bash
set -euo pipefail
# vale config hash: {{ include "dot_config/vale/dot_vale.ini" | sha256sum }}
# Downloads the style packages named in ~/.config/vale/.vale.ini into
# ~/.config/vale/styles.
#
# VALE_CONFIG_PATH is explicit because vale finds its global config through
# XDG_CONFIG_HOME, which defaults to ~/Library/Application Support on macOS.
# A run script does not inherit the fish environment that sets the variable,
# so a fresh macOS machine would otherwise report "no sources provided".
export VALE_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/vale/.vale.ini"
vale sync
{{ end -}}
