{{- /* Zed names the space key "space". */ -}}
{{- $leader := .keys.leader | replace " " "space" -}}
[
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "{{ $leader }} f f": "file_finder::Toggle",
      "{{ $leader }} e": "project_panel::ToggleFocus",
      "{{ $leader }} t": "terminal_panel::ToggleFocus",
      "{{ $leader }} c a": "editor::ToggleCodeActions",
      "{{ $leader }} c r": "editor::Rename",
      "{{ $leader }} c f": "editor::Format",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "K": "editor::Hover",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "{{ $leader }} f b": "tab_switcher::Toggle",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::SwitchToNormalMode"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "{{ $leader }} e": "workspace::ToggleLeftDock",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-h": "workspace::ToggleLeftDock"
    }
  }
]
