# Agent launchers, one per entry in .chezmoidata/agents.toml. Each function
# installs its agent on first use, then runs it through `sb` with the tmux
# window or zellij tab pinned to the agent name. `command <agent>` skips both.
{{ range $name, $agent := .agents }}
function {{ $name }} --wraps {{ $name }} --description "{{ $agent.description }} in a nono sandbox"
    if not command -q {{ $name }}
{{- if (get $agent "install") }}
        printf '  Installing {{ $name }}...\n'
        {{ (get $agent "install") }}; or return
{{- else }}
        printf '  {{ $name }}: not installed; run `chezmoi apply`\n' >&2
        return 127
{{- end }}
    end
{{- if (get $agent "unsandboxed") }}
    # Subcommands that rewrite the install itself run outside the sandbox.
    if contains -- "$argv[1]" {{ (get $agent "unsandboxed") | join " " }}
        command {{ $name }} $argv
        return
    end
{{- end }}
{{- if (get $agent "prelaunch") }}

{{ (get $agent "prelaunch") | indent 4 }}
{{- end }}

    _ai_run_pinned {{ $name }} sb {{ $name }} $argv
end
{{ end -}}
