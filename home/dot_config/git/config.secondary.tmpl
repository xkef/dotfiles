{{ if lookPath "op" -}}
# Secondary GitHub identity. The [includeIf] in ./config activates it by
# remote URL. The SSH agent serves the signing key from the 1Password Work
# vault.

[user]
	name = {{ onepasswordRead "op://Work/git/name" }}
	email = {{ onepasswordRead "op://Work/git/noreply_email" }}
	signingkey = key::{{ onepasswordRead "op://Work/4iwi4zirnfsx643om5beg2y5ua/public key" }}
{{ end -}}
