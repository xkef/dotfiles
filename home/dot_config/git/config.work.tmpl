{{ if and .work (lookPath "op") -}}
# Rendered by chezmoi from the Work/git 1Password item. The [includeIf] in
# ./config activates it inside ~/work/ only.

[user]
	name = {{ onepasswordRead "op://Work/git/name" }}
	email = {{ onepasswordRead "op://Work/git/email" }}

[commit]
	gpgsign = false

[tag]
	gpgsign = false
{{ end -}}
