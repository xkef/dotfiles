# ── Terminal capabilities ────────────────────────────
# tmux-256color is the terminfo entry with 256 colors and italics.
# terminal-overrides declares RGB support for the outer terminals.
# See https://github.com/tmux/tmux/wiki/FAQ#how-do-i-use-rgb-colour
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB,alacritty:RGB,xterm-kitty:RGB"

# Forward CSI u modified keys such as Ctrl-Shift-A to apps inside tmux that
# ask for them. Don't force extkeys on the outer terminal with
# `terminal-features 'xterm*:extkeys'`. That puts Ghostty into
# modifyOtherKeys mode 2, whose encoder translates shifted digit keys
# through a US layout. On Swiss German, Shift+3 (*) arrives as # and
# Shift+0 (=) as ), which breaks prefix bindings and typing.
# See https://github.com/tmux/tmux/wiki/Modifier-Keys
set -s extended-keys on
set -s extended-keys-format csi-u

# usstyle enables curly, dotted, dashed, and colored underlines, which
# neovim diagnostics and git signs use. sync enables synchronized output,
# which reduces flicker on fast updates.
set -as terminal-features ',*:usstyle'
set -as terminal-features ',*:sync'

# tmux stores OSC 8 hyperlinks, such as delta's file links, but re-emits
# them only to terminals with the hyperlinks feature. It doesn't detect
# Ghostty.
set -as terminal-features ',xterm-ghostty:hyperlinks'

# ── General options ──────────────────────────────────
set -ga update-environment PATH     # inherit PATH from the attaching shell
set -g mouse on
set -g history-limit 50000
set -g scroll-on-clear off          # `clear` keeps the scrollback
set -g detach-on-destroy no-detached # switch to another session instead of detaching
set -g display-time 4000
set -g status-interval 5
set -g focus-events on              # neovim uses FocusGained and FocusLost
set -g set-clipboard on             # OSC 52 clipboard, works from remote sessions
set -g allow-passthrough on         # OSC sequences for themes and images reach the terminal
set -sg escape-time 0               # no delay after Escape, which vim needs
set -g base-index 1                 # 0 sits far from the prefix key
setw -g pane-base-index 1
set -g renumber-windows on
setw -g aggressive-resize on        # resize to the smallest client viewing the window

# ── Prefix key ───────────────────────────────────────
# Set in .chezmoidata/keys.toml. Pairing the prefix with the neovim leader,
# after wincent, lets one physical key serve both. Ctrl-A and Ctrl-B stay
# free for readline beginning-of-line and page-up.
# See https://github.com/wincent/wincent
unbind C-b
set -g prefix {{ .keys.prefix }}

# @key tmux :: {{ .keys.prefix_label }} :: Toggle last window (double-tap)
bind {{ .keys.prefix }} last-window
