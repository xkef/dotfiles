#!/usr/bin/env bash
# Desktop notification for a finished Codex turn.
#
# Codex passes the payload as one JSON argument rather than on stdin, and
# emits a single event type today. Wired in through the `notify` key in
# ~/.codex/config.toml.
set -euo pipefail

readonly TURN_COMPLETE=agent-turn-complete

payload=${1:-}
[ -n "$payload" ] || exit 0

[ "$(jq -r '.type // empty' <<<"$payload")" = "$TURN_COMPLETE" ] || exit 0

"$HOME/.local/bin/agent-notify" Codex \
  "$(jq -r '."last-assistant-message" // empty' <<<"$payload")"
