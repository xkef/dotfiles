#!/usr/bin/env bash
# Cross-session agent picker.
#
# Joins the state files each agent writes, keyed by tmux pane id, against the
# live pane list. An agent whose pane is gone has no row to join to, so a
# crashed session drops out of the view on its own. Claude Code writes those
# files from a hook, pi from an extension. Codex has neither, so the live pane
# command identifies it and it shows as running. Agents publish task summaries
# separately.
#
#   tmux-agents          fzf picker. Enter switches to the agent's pane.
#   tmux-agents --count  status line segment ("2◐ 1●"), empty when nothing runs
set -euo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agents"

# Glyph weight encodes the state, so the status line doesn't need color. A
# filled dot needs input, a ring works, a small dot idles.
readonly ICON_WAITING='•'
readonly ICON_BUSY='◦'
readonly ICON_RUNNING='○'
readonly ICON_IDLE='·'

# Sort ranks: needs input first, working next, idle last.
readonly RANK_WAITING=0
readonly RANK_BUSY=1
readonly RANK_RUNNING=2
readonly RANK_IDLE=3

# Emits tab-separated rank, pane, target, state, agent, tool, age, dir, and task.
collect() {
  local now pane target command agent state tool epoch cwd rank age task
  now=$(date +%s)

  while IFS=$'\t' read -r pane target command cwd; do
    if [[ "$command" == codex ]]; then
      agent=codex state=running tool=- age=-
    else
      [ -f "$STATE_DIR/$pane" ] || continue
      IFS=$'\t' read -r agent state tool epoch cwd <"$STATE_DIR/$pane" || continue
      age=$(human_age $((now - epoch)))
    fi
    task=$(agent-task --read "$pane" 2>/dev/null) || task=-
    task=${task:--}

    case "$state" in
    waiting) rank=$RANK_WAITING ;;
    busy) rank=$RANK_BUSY ;;
    running) rank=$RANK_RUNNING ;;
    *) rank=$RANK_IDLE ;;
    esac

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$rank" "$pane" "$target" "$state" "$agent" "$tool" \
      "$age" "${cwd/#$HOME/~}" "$task"
  done < <(tmux list-panes -a -F '#{pane_id}	#{session_name}:#{window_index}	#{pane_current_command}	#{pane_current_path}') |
    sort -n
}

human_age() { # seconds to "12s", "6m", or "2h"
  local s=$1
  ((s < 60)) && {
    printf '%ds' "$s"
    return
  }
  ((s < 3600)) && {
    printf '%dm' $((s / 60))
    return
  }
  printf '%dh' $((s / 3600))
}

# ── Count mode ───────────────────────────────────────
# Counts every agent in the picker's sort order, so a count keeps its position
# as the states around it change. A state without agents produces nothing. With
# no agents at all the segment stays empty, and the status line looks as it did
# before any agent existed.
if [[ "${1:-}" == --count ]]; then
  waiting=0 busy=0 running=0 idle=0
  while IFS=$'\t' read -r _ _ _ state _; do
    case "$state" in
    waiting) ((++waiting)) ;;
    busy) ((++busy)) ;;
    running) ((++running)) ;;
    *) ((++idle)) ;;
    esac
  done < <(collect)

  segment=""
  append() { segment="$segment${segment:+ }$1$2"; }
  ((waiting > 0)) && append "$waiting" "$ICON_WAITING"
  ((busy > 0)) && append "$busy" "$ICON_BUSY"
  ((running > 0)) && append "$running" "$ICON_RUNNING"
  ((idle > 0)) && append "$idle" "$ICON_IDLE"

  [ -n "$segment" ] && printf '%s  ' "$segment"
  exit 0
fi

# ── Picker mode ──────────────────────────────────────
# Each fzf line is "pane<TAB>target<TAB>display". --with-nth=3 shows only the
# rendered column, so a path with spaces can't break the field split.
#
# Each column takes the width of its widest value, and a column that stays
# empty for every agent disappears. Fixed widths padded one agent out to a line
# of mostly blanks.
render() {
  local _rank pane target state agent tool age dir task icon color display row
  local -r RED='\033[31m' YELLOW='\033[33m' DIM='\033[2m' RESET='\033[0m'
  local -a entries=()
  # Rows use a unit separator instead of a tab. read treats a tab as
  # whitespace and folds a run of them into one, which would shift every column
  # of an agent without a tool.
  local -r SEP=$'\x1f'
  local w_state=0 w_agent=0 w_target=0 w_dir=0 w_tool=0 w_task=0

  while IFS=$'\t' read -r _rank pane target state agent tool age dir task; do
    [[ "$tool" == - ]] && tool=""
    [[ "$task" == - ]] && task=""
    entries+=("$pane$SEP$target$SEP$state$SEP$agent$SEP$tool$SEP$age$SEP$dir$SEP$task")
    ((${#state} > w_state)) && w_state=${#state}
    ((${#agent} > w_agent)) && w_agent=${#agent}
    ((${#target} > w_target)) && w_target=${#target}
    ((${#dir} > w_dir)) && w_dir=${#dir}
    ((${#tool} > w_tool)) && w_tool=${#tool}
    ((${#task} > w_task)) && w_task=${#task}
  done

  ((w_state > 0)) || return 0
  for row in "${entries[@]}"; do
    IFS=$SEP read -r pane target state agent tool age dir task <<<"$row"
    case "$state" in
    waiting) icon=$ICON_WAITING color=$RED ;;
    busy) icon=$ICON_BUSY color=$YELLOW ;;
    running) icon=$ICON_RUNNING color=$DIM ;;
    *) icon=$ICON_IDLE color=$DIM ;;
    esac

    # Pad the state word before coloring it. printf counts the escape bytes and
    # would otherwise pad the column short.
    printf -v display '%b%s %-*s%b  %-*s  %-*s' \
      "$color" "$icon" "$w_state" "$state" "$RESET" \
      "$w_agent" "$agent" "$w_target" "$target"
    if ((w_task > 0)); then
      printf -v display '%s  %-*s' "$display" "$w_task" "$task"
    fi
    printf -v display '%s  %-*s' "$display" "$w_dir" "$dir"
    if ((w_tool > 0)); then
      printf -v display '%s  %-*s' "$display" "$w_tool" "$tool"
    fi
    printf -v display '%s  %b%s%b' "$display" "$DIM" "$age" "$RESET"

    printf '%s\t%s\t%s\n' "$pane" "$target" "$display"
  done
}

rows=$(collect | render)
if [ -z "$rows" ]; then
  tmux display-message "No agents running"
  exit 0
fi

# --height overrides the 60% in FZF_DEFAULT_OPTS. The picker fills the whole
# popup, so anything less leaves the bottom of it blank.
selection=$(printf '%s\n' "$rows" | fzf \
  --height=100% \
  --ansi --no-sort --reverse \
  --gap=0 --no-separator \
  --delimiter='\t' --with-nth=3 \
  --border-label ' agents ' --prompt '> ' \
  --header 'enter jump | ctrl-/ preview' \
  --bind 'tab:down,btab:up' \
  --bind 'ctrl-d:preview-half-page-down' \
  --bind 'ctrl-u:preview-half-page-up' \
  --bind 'ctrl-/:toggle-preview' \
  --preview-window 'down:75%,wrap,follow' \
  --preview 'tmux capture-pane -p -e -t {1}') || exit 0

IFS=$'\t' read -r pane target _ <<<"$selection"
tmux switch-client -t "$target"
tmux select-pane -t "$pane"
