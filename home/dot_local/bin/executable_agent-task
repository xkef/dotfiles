#!/usr/bin/env bash
# Publishes a short task summary for the tmux agents pane.
set -euo pipefail

# Every pane shares this per-user directory under /tmp, and agent sandboxes
# can write it without access to the tmux socket.
TASK_DIR="/tmp/tmux-agent-tasks-$(id -u)"
readonly TASK_DIR
readonly MAX_SUMMARY_LENGTH=60

# A zellij pane id repeats across sessions, so its key adds the session name.
readonly PANE_KEY='^(%[0-9]+|zellij-[^/]+-[0-9]+)$'
pane=${TMUX_PANE:-${ZELLIJ_PANE_ID:+zellij-$ZELLIJ_SESSION_NAME-$ZELLIJ_PANE_ID}}
if [[ "${1:-}" == --read ]]; then
  pane=${2:-$pane}
  [[ "$pane" =~ $PANE_KEY ]] || exit 1
  cat "$TASK_DIR/$pane" 2>/dev/null
  exit 0
fi

[[ "$pane" =~ $PANE_KEY ]] || exit 0
summary=$(printf '%s' "$*" | tr '\t\r\n' '   ')
[ -n "$summary" ] || exit 0

umask 077
mkdir -p "$TASK_DIR"
tmp=$(mktemp "$TASK_DIR/$pane.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "${summary:0:MAX_SUMMARY_LENGTH}" >"$tmp"
mv -f "$tmp" "$TASK_DIR/$pane"
