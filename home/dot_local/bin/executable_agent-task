#!/usr/bin/env bash
# Publishes a short task summary for the tmux agents pane.
set -euo pipefail

# A per-user directory under /tmp is shared across panes and writable from
# agent sandboxes without granting access to the tmux socket.
TASK_DIR="/tmp/tmux-agent-tasks-$(id -u)"
readonly TASK_DIR
readonly MAX_SUMMARY_LENGTH=60

pane=${TMUX_PANE:-}
if [[ "${1:-}" == --read ]]; then
  pane=${2:-$pane}
  [[ "$pane" =~ ^%[0-9]+$ ]] || exit 1
  cat "$TASK_DIR/$pane" 2>/dev/null
  exit 0
fi

[[ "$pane" =~ ^%[0-9]+$ ]] || exit 0
summary=$(printf '%s' "$*" | tr '\t\r\n' '   ')
[ -n "$summary" ] || exit 0

umask 077
mkdir -p "$TASK_DIR"
tmp=$(mktemp "$TASK_DIR/$pane.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "${summary:0:MAX_SUMMARY_LENGTH}" >"$tmp"
mv -f "$tmp" "$TASK_DIR/$pane"
