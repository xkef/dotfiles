#!/usr/bin/env fish
# shellcheck disable=all
# dots — unified dotfiles management command.
# Thin dispatcher over the chezmoi-era tools.
#
# Usage: dots <command> [args]

switch $argv[1]
    case update up
        chezmoi update $argv[2..-1]
    case doctor check
        chezmoi doctor $argv[2..-1]
    case diff
        chezmoi diff $argv[2..-1]
    case apply
        chezmoi apply $argv[2..-1]
    case keys
        dots-keys $argv[2..-1]
    case skills
        dots-skills $argv[2..-1]
    case theme
        theme $argv[2..-1]
    case help -h --help ''
        echo "Usage: dots <command>"
        echo ""
        echo "Commands:"
        echo "  update    Pull the repo and apply changes (chezmoi update)"
        echo "  doctor    Check dotfiles health (chezmoi doctor)"
        echo "  diff      Show pending changes (chezmoi diff)"
        echo "  apply     Apply the source state (chezmoi apply)"
        echo "  keys      Show keybinding reference"
        echo "  skills    Refresh shared agent skills from upstream"
        echo "  theme     Switch terminal + editor theme"
        echo ""
    case '*'
        echo "Unknown command: $argv[1]"
        echo "Run 'dots help' for usage."
        return 1
end
