#!/usr/bin/env bash
# Workspace picker for WezTerm. Lists open workspaces, zoxide directories,
# and a directory search.
#
#   mux-workspaces                  fzf picker. Enter switches workspace.
#   mux-workspaces list <source>    rows for all, workspaces, zoxide, or find
#   mux-workspaces preview <name> <path>
#   mux-workspaces kill <name>      closes every pane of a workspace
#
# Each row reads "display<TAB>name<TAB>path". A workspace row has no path.
# WezTerm can't switch workspace from the CLI, so the picker sets the
# switch_workspace user var to "name<TAB>path" and waits.
# ~/.config/wezterm/picker.lua reads it, closes the picker, and switches.
set -euo pipefail

# How long the picker waits to be closed after it reports a choice.
readonly PICKER_WAIT=5

readonly BLUE='\033[34m' CYAN='\033[36m' YELLOW='\033[33m' RESET='\033[0m'

# Nerd Font icons per source: terminal, folder, and magnifier.
readonly ICON_WORKSPACE=$'\xef\x92\x89' ICON_ZOXIDE=$'\xef\x81\xbb'
readonly ICON_FIND=$'\xef\x80\x82'

# Prints ~ for $HOME at the start of a path.
tilde() {
  case "$1" in
  "$HOME" | "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
  *) printf '%s' "$1" ;;
  esac
}

# Emits rows for directories on stdin, named after their last component.
dir_rows() {
  local color=$1 icon=$2 dir
  while IFS= read -r dir; do
    printf '%b%s%b %s\t%s\t%s\n' "$color" "$icon" "$RESET" "$(tilde "$dir")" "${dir##*/}" "$dir"
  done
}

workspaces() {
  wezterm cli list --format json | jq -r '[.[].workspace] | unique[]' |
    while IFS= read -r name; do
      printf '%b%s%b %s\t%s\t\n' "$BLUE" "$ICON_WORKSPACE" "$RESET" "$name" "$name"
    done
}

zoxide_dirs() {
  zoxide query --list 2>/dev/null | dir_rows "$CYAN" "$ICON_ZOXIDE"
}

find_dirs() {
  fd -H -d 2 -t d -E .Trash . "$HOME" 2>/dev/null | sed 's:/$::' | dir_rows "$YELLOW" "$ICON_FIND"
}

list() {
  case "${1:-all}" in
  workspaces) workspaces ;;
  zoxide) zoxide_dirs ;;
  find) find_dirs ;;
  *)
    workspaces
    zoxide_dirs
    ;;
  esac
}

# A workspace shows its first pane, and a directory its listing.
preview() {
  local name=$1 dir=${2:-} pane
  if [ -n "$dir" ]; then
    eza -la --group-directories-first --git --icons --color=always "$dir"
    return
  fi
  pane=$(wezterm cli list --format json |
    jq -r --arg w "$name" 'first(.[] | select(.workspace == $w) | .pane_id)')
  wezterm cli get-text --escapes --pane-id "$pane"
}

kill_workspace() {
  wezterm cli list --format json |
    jq -r --arg w "$1" '.[] | select(.workspace == $w) | .pane_id' |
    while IFS= read -r pane; do
      wezterm cli kill-pane --pane-id "$pane"
    done
}

case "${1:-}" in
list)
  list "${2:-}"
  exit 0
  ;;
preview)
  preview "$2" "${3:-}"
  exit 0
  ;;
kill)
  kill_workspace "$2"
  exit 0
  ;;
esac

# The picker runs in a zoomed split that fills the tab, and the margin
# insets it like an 80% by 70% popup.
selection=$(list all | fzf \
  --height=100% --margin=15%,10% \
  --ansi --no-sort --reverse \
  --gap=0 --no-separator \
  --delimiter='\t' --with-nth=1 \
  --border-label ' workspaces ' --prompt '> ' \
  --header 'C-a all | C-t workspaces | C-x zoxide | C-f find | C-w kill | C-/ preview' \
  --bind 'tab:down,btab:up' \
  --bind 'ctrl-a:change-prompt(> )+reload(mux-workspaces list all)' \
  --bind 'ctrl-t:change-prompt(workspaces> )+reload(mux-workspaces list workspaces)' \
  --bind 'ctrl-x:change-prompt(zoxide> )+reload(mux-workspaces list zoxide)' \
  --bind 'ctrl-f:change-prompt(find> )+reload(mux-workspaces list find)' \
  --bind 'ctrl-d:preview-half-page-down' \
  --bind 'ctrl-u:preview-half-page-up' \
  --bind 'ctrl-/:toggle-preview' \
  --bind 'ctrl-w:execute(mux-workspaces kill {2})+change-prompt(> )+reload(mux-workspaces list all)' \
  --preview-window 'right:55%,hidden,wrap' \
  --preview 'mux-workspaces preview {2} {3}') || exit 0

IFS=$'\t' read -r _ name dir <<<"$selection"
printf '\033]1337;SetUserVar=switch_workspace=%s\007' \
  "$(printf '%s\t%s' "$name" "$dir" | base64 | tr -d '\n')" >/dev/tty
sleep "$PICKER_WAIT"
