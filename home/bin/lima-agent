#!/usr/bin/env bash
# Runs Claude Code in the Lima VM from ~/.config/lima/dev.yaml, in the
# current directory, with permission prompts off. The VM is the sandbox:
# it sees ~/code and ~/work at their host paths and nothing else of $HOME.
#
#   lima-agent [claude args...]
#
# The OAuth token comes from 1Password on every launch and reaches the
# guest through stdin, so it never shows up in a process list. The guest
# deletes its copy once the agent has it in its environment. The host's gh
# token for GH_USER takes the same path and logs gh in the guest, where it
# stays for plain shells and git. WEZTERM_PANE
# goes along so the agent's hooks report to the `mux-agents` picker.
set -euo pipefail

readonly VM=dev
readonly TOKEN_REF="op://Private/Claude Code/token"
readonly GH_USER=xkef
readonly SHARED_DIRS=("$HOME/code" "$HOME/work")

shared=false
for dir in "${SHARED_DIRS[@]}"; do
  case "$PWD/" in "$dir"/*) shared=true ;; esac
done
if [ "$shared" = false ]; then
  echo "lima-agent: $PWD is not shared with the VM" >&2
  exit 1
fi

# The VM mounts the agent state directory and its transcript directory,
# which must exist first.
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/agents/lima-$VM/claude-projects"
mkdir -p "$HOME/.cache/lima-clipboard"

# Reads the tokens before the VM starts, so a missing token fails fast.
token=$(op read "$TOKEN_REF")
gh_token=$(gh auth token --user "$GH_USER")
token_file=".cache/lima-agent/token.$$"

# The guest's fish runs without a prompt, so it never reports its
# directory. OSC 7 with the VM's host name tells WezTerm the pane works in
# the VM, which the status line marks and splits follow.
if [ -t 1 ]; then
  printf '\e]7;file://lima-%s%s\e\\' "$VM" "$PWD"
fi

# The first line holds the gh token, which gh stores in a file since the
# guest has no keyring. Logging in again only follows a token change.
printf '%s\n%s' "$gh_token" "$token" |
  limactl shell --start --workdir / "$VM" -- sh -c '
    IFS= read -r gh
    [ "$(gh auth token 2>/dev/null)" = "$gh" ] ||
      printf %s "$gh" | gh auth login --with-token --insecure-storage
    f="$HOME/$1" && umask 077 && mkdir -p "${f%/*}" && cat >"$f"' sh "$token_file"

exec limactl shell --workdir "$PWD" "$VM" -- \
  env WEZTERM_PANE="${WEZTERM_PANE:-}" fish -lc '
    set -lx CLAUDE_CODE_OAUTH_TOKEN (cat ~/$argv[1])
    rm ~/$argv[1]
    # First-run onboarding asks for a login even with a token set, and
    # the VM replaces the folder trust prompt. Claude Code rewrites this
    # file while it runs, so it changes only when a key is missing.
    set -l cfg ~/.claude.json
    set -l ready ".hasCompletedOnboarding and .projects[\$dir].hasTrustDialogAccepted"
    test -f $cfg; or echo "{}" >$cfg
    if not jq -e --arg dir $PWD $ready $cfg >/dev/null
        set -l tmp (mktemp)
        jq --arg dir $PWD ".hasCompletedOnboarding = true | .projects[\$dir].hasTrustDialogAccepted = true" $cfg >$tmp
        and mv $tmp $cfg
    end
    command claude --dangerously-skip-permissions $argv[2..]
    set -l rc $status
    agent-state clear
    exit $rc' "$token_file" "$@"
