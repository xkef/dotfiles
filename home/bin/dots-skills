#!/usr/bin/env fish
# dots-skills: installs shared agent skills from upstream packs.
#
# Holds the install sentinel and the upstream source list. Tracked skills,
# which dotter links into ~/.agents/skills/, stay untouched.
#
# Usage:
#   dots-skills ensure [agent]    install once, no-op while the sentinel exists
#   dots-skills refresh [agent]   drop the sentinel and reinstall from upstream
#   dots-skills                   same as refresh

# Upstream skill packs as '<repo> <skill>'. '*' installs every skill.
set -l upstreams \
    'mattpocock/skills *' \
    'vercel-labs/skills find-skills' \
    '2ykwang/agent-skills html-visual' \
    'Cocoon-AI/architecture-diagram-generator architecture-diagram' \
    'blader/humanizer humanizer'

# The sentinel name carries a digest of the list above, so editing the list
# reinstalls on the next launch without a manual version bump.
set -l sentinel_dir "$HOME/.cache/dotfiles"
set -l digest (string join \n $upstreams | shasum -a 256 | string sub -l 12)
set -l sentinel "$sentinel_dir/skills.shared.$digest.installed"

# The skills CLI installs into ~/.agents/skills through its claude-code
# target. pi reads the same tree.
set -l install_target claude-code

# fish fails a command whose wildcard matches nothing. set accepts an empty
# match, so the glob expands there first.
function remove_sentinels --inherit-variable sentinel_dir
    set -l stale $sentinel_dir/skills.shared.*.installed
    rm -f $stale
end

set -l verb $argv[1]
set -l agent (test -n "$argv[2]"; and echo $argv[2]; or echo agents)

switch "$verb"
    case ensure refresh
    case ''
        set verb refresh
    case '*'
        echo "usage: dots-skills [ensure|refresh] [agent]" >&2
        exit 2
end

if test "$verb" = refresh
    remove_sentinels
end

test -f $sentinel; and exit 0
command -q npx; or exit 0

printf '\033[33m(installing shared skills for %s...)\033[0m\n' $agent >&2
for entry in $upstreams
    set -l parts (string split ' ' -- $entry)
    npx --yes skills@latest add $parts[1] \
        --global --agent $install_target --skill $parts[2] -y
    or exit $status
end

mkdir -p $sentinel_dir
remove_sentinels
touch $sentinel
