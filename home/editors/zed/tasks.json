[
  {
    "label": "Maven: build",
    "command": "mvn",
    "args": ["clean", "compile"]
  },
  {
    "label": "Maven: test",
    "command": "mvn",
    "args": ["test"]
  },
  {
    "label": "Maven: test (current file)",
    "command": "mvn",
    "args": ["test", "-Dtest=$ZED_STEM"]
  },
  {
    "label": "Maven: package",
    "command": "mvn",
    "args": ["clean", "package", "-DskipTests"]
  },
  {
    "label": "Gradle: build",
    "command": "./gradlew",
    "args": ["build"]
  },
  {
    "label": "Gradle: test",
    "command": "./gradlew",
    "args": ["test"]
  },
  {
    "label": "Gradle: test (current file)",
    "command": "./gradlew",
    "args": ["test", "--tests", "$ZED_STEM"]
  }
]
