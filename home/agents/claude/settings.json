{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": false,
  "autoMode": {
    "classifyAllShell": true
  },
  "cleanupPeriodDays": 99999,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "nono@always-further": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "GITHUB_TOKEN": "",
    "INSIDE_CLAUDE_CODE": "1"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-notify-hook",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-post-tool-use-hook",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-pre-tool-use-hook",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-no-trailer",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/claude-agent-status",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "concise",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Skill",
      "WebSearch",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*rm -r -f*)",
      "Bash(*rm -f -r*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*git merge *)",
      "Bash(*git rebase*)",
      "Bash(*git reset --hard*)",
      "Bash(*git checkout -- *)",
      "Bash(*git clean*)",
      "Bash(*git stash drop*)",
      "Bash(*jj abandon*)",
      "Bash(*jj restore*)",
      "Bash(*> .env*)",
      "Bash(*> .env.*)"
    ]
  },
  "plansDirectory": ".claude-notes",
  "preferredNotifChannel": "iterm2",
  "sandbox": {
    "credentials": {
      "files": [
        {
          "mode": "deny",
          "path": "~/.config/gh/hosts.yml"
        }
      ]
    },
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": ["gh *", "jj *"],
    "filesystem": {
      "allowWrite": ["~/.cache/mise", "~/.local/state/agents"]
    },
    "network": {
      "allowUnixSockets": [
        "/Users/kk/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Processing"]
  },
  "statusLine": {
    "command": "~/.claude/hooks/claude-statusline",
    "type": "command"
  },
  "tui": "fullscreen"
}
