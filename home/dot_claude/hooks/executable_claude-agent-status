#!/bin/bash
# Maps Claude Code hook events to agent states for the `mux-agents` picker
# and the WezTerm status line. `agent-state` owns the storage and the format.
#
# Claude Code runs hooks as child processes, so they inherit WEZTERM_PANE
# from the pane the agent started in, and `agent-state` finds the pane
# through it.

[ -n "$WEZTERM_PANE" ] || exit 0

AGENT_STATE="$HOME/.local/bin/agent-state"

INPUT=$(cat)
IFS=$'\t' read -r EVENT TOOL CWD < <(
  echo "$INPUT" | jq -r '[.hook_event_name, (.tool_name // "-"), (.cwd // "-")] | @tsv'
)

if [ "$EVENT" = SessionEnd ]; then
  "$AGENT_STATE" clear
  exit 0
fi

# Only PreToolUse names a tool. Every other event describes the agent as a
# whole, so it clears the column instead of leaving a stale tool name.
[ "$EVENT" = PreToolUse ] || TOOL=-

# Notification fires for a permission prompt and for an idle nudge. Either
# way the agent waits for a look, so both read as "waiting".
case "$EVENT" in
SessionStart | Stop) STATE=idle ;;
UserPromptSubmit | PreToolUse) STATE=busy ;;
Notification) STATE=waiting ;;
*) exit 0 ;;
esac

# Exit 0 whatever happens. Exit 2 from a PreToolUse hook blocks the tool.
"$AGENT_STATE" set claude "$STATE" "$TOOL" "$CWD"
exit 0
