#!/bin/bash
# Refuses any command that would write a Claude-Session trailer into a commit
# message.
#
# The harness tells the agent to append that trailer, and an instruction in
# CLAUDE.md only competes with it. This blocks at the tool boundary instead,
# which nothing in a prompt can argue its way past.
#
# The needle is assembled rather than written out, so this file does not match
# its own pattern and stays editable through Bash.

readonly TRAILER="Claude-Session"

INPUT=$(cat)
COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty')

[ -z "$COMMAND" ] && exit 0

if [[ "$COMMAND" == *"$TRAILER":* ]]; then
  echo "Blocked: commit messages never carry a $TRAILER trailer. Remove it and retry." >&2
  exit 2
fi

exit 0
