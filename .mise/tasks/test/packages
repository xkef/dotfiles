#!/usr/bin/env bash
#MISE description="Check that a failed cask warns and a failed formula fails"
#MISE hide=true
set -eu
. .mise/lib.sh
scratch test-packages

# Stubs make the installer take the macOS path. `brew bundle check`
# reports every list incomplete, and brew fails on the list whose file
# name matches BREW_FAIL.
mkdir "$tmp/bin"
printf '#!/bin/sh\necho Darwin\n' >"$tmp/bin/uname"
cat >"$tmp/bin/brew" <<'EOF'
#!/bin/sh
echo "$*" >>"$BREW_LOG"
case "$*" in "bundle check"* | *"$BREW_FAIL"*) exit 1 ;; esac
EOF
# The curl stub stands in for the mise.run script, which installs into
# ~/.local/bin of an empty HOME.
cat >"$tmp/bin/curl" <<'EOF'
#!/bin/sh
printf 'mkdir -p "$HOME/.local/bin"\nprintf "#!/bin/sh\\n" >"$HOME/.local/bin/mise"\nchmod +x "$HOME/.local/bin/mise"\n'
EOF
chmod +x "$tmp/bin"/*
export PATH="$tmp/bin:$PATH" BREW_LOG="$tmp/brew.log" CI=false DOTFILES_PACKAGES="core desktop"
export BREW_FAIL=desktop.casks HOME="$tmp/home"

setup/packages/install 2>/dev/null || fail "a cask failure failed the install"
grep -q core "$BREW_LOG" || fail "selected core list skipped"
[ -x "$HOME/.local/bin/mise" ] || fail "core didn't install mise"
! grep -q agents "$BREW_LOG" || fail "unselected agents list installed"

# A failed formula fails the install, even in a list that also holds a
# cask.
! BREW_FAIL=core.formulae setup/packages/install 2>/dev/null ||
  fail "a formula failure passed"

# Without admin, a brew prefix this user can't write installs nothing,
# and a fish on PATH needs no download.
cat >"$tmp/bin/brew" <<'EOF2'
#!/bin/sh
case "$*" in --prefix) echo /System ;; *) echo "$*" >>"$BREW_LOG" ;; esac
EOF2
printf '#!/bin/sh\nexit 1\n' >"$tmp/bin/curl"
printf '#!/bin/sh\n' >"$tmp/bin/fish"
chmod +x "$tmp/bin"/*
: >"$BREW_LOG"
DOTFILES_ADMIN=no setup/packages/install 2>/dev/null || fail "no-admin install failed"
[ ! -s "$BREW_LOG" ] || fail "no-admin ran brew on a prefix it can't write"

# --list prints the selected lists and installs nothing.
out=$(setup/packages/install --list)
grep -q '^core:$' <<<"$out" || fail "--list lacks core"
! grep -q '^agents:$' <<<"$out" || fail "--list shows an unselected module"
[ ! -s "$BREW_LOG" ] || fail "--list ran brew"
echo "packages ok"
