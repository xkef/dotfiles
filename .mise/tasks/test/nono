#!/usr/bin/env bash
#MISE description="Check that the nono profiles keep host-run files read-only"
#MISE hide=true
set -eu
profiles=$PWD/modules/agents/.config/nono/profiles

fail() {
  echo "$1" >&2
  exit 1
}

if ! command -v nono >/dev/null; then
  echo "nono skipped: nono is not installed"
  exit 0
fi

# The claude profile grants /tmp/claude-$UID, which may hold $TMPDIR, so
# the throwaway HOME lives in the checkout.
mkdir -p .claude/tmp
tmp=$(mktemp -d "$PWD/.claude/tmp/test-nono.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# nono resolves the profiles and their paths under a throwaway HOME.
export HOME="$tmp/home"
export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" \
  XDG_CACHE_HOME="$HOME/.cache" XDG_STATE_HOME="$HOME/.local/state"
mkdir -p "$XDG_CONFIG_HOME/nono" "$tmp/work"
cp -R "$profiles" "$XDG_CONFIG_HOME/nono/profiles"
printf '[updates]\ncheck = false\n' >"$XDG_CONFIG_HOME/nono/config.toml"

# Prints ALLOWED or DENIED for operation $1 on path $2 in the claude
# profile.
verdict() {
  nono why --profile claude --allow "$tmp/work" --op "$1" --path "$2" 2>/dev/null |
    grep -m1 -E '^(ALLOWED|DENIED)$'
}

# The host runs what these hold, outside the sandbox: toolchains, crate
# sources, jars, npx packages, jj's per-repository config, and VS Code
# extensions.
host_paths=("$XDG_DATA_HOME/rustup/toolchains" "$XDG_DATA_HOME/uv/tools"
  "$XDG_DATA_HOME/go/bin" "$XDG_DATA_HOME/cargo/registry/src"
  "$XDG_CACHE_HOME/uv" "$HOME/.m2/repository" "$XDG_CONFIG_HOME/jj/repos"
  "$HOME/.npm/_npx" "$HOME/.vscode/extensions")
if [ "$(uname)" = Darwin ]; then
  host_paths+=("$HOME/Library/Caches/go-build"
    "$HOME/Library/Application Support/Code/User")
fi

# The toolchain homes the profile sets, as VAR=path lines. A toolchain
# home that the profile doesn't set would point at the host's.
homes=$(jq -r '.environment.set_vars // {} | to_entries[] | "\(.key)=\(.value)"' "$profiles/agents.json")
home_vars=(CARGO_HOME RUSTUP_HOME GOPATH GOBIN GOCACHE UV_CACHE_DIR
  UV_PYTHON_INSTALL_DIR UV_TOOL_DIR UV_TOOL_BIN_DIR npm_config_cache MAVEN_USER_HOME
  MISE_CACHE_DIR)
home_paths=()
for var in "${home_vars[@]}"; do
  value=$(printf '%s\n' "$homes" | sed -n "s/^$var=//p")
  [ -n "$value" ] || fail "the profile leaves $var at the host's"
  home_paths+=("$(eval "printf '%s' \"$value\"")")
done
printf '%s\n' "$homes" | grep -q '^MAVEN_OPTS=.*-Dmaven\.repo\.local=' ||
  fail "Maven writes the host's ~/.m2/repository"

# nono skips a grant whose path doesn't exist, so every path exists before
# the checks.
mkdir -p "${host_paths[@]}" "${home_paths[@]}" "$HOME/.local/libexec/agents" \
  "$XDG_CACHE_HOME/mise/exec" "$HOME/.agents"
touch "$HOME/.m2/settings.xml"

for path in "${host_paths[@]}"; do
  [ "$(verdict write "$path")" = DENIED ] || fail "the agent may write $path"
done
for path in "${home_paths[@]}"; do
  [ "$(verdict write "$path")" = ALLOWED ] || fail "the agent may not write $path"
done

# mise caches the output of a config's exec() templates, which may be a
# token, in its exec cache.
[ "$(verdict read "$XDG_CACHE_HOME/mise/exec")" = DENIED ] ||
  fail "the agent may read mise's exec cache"

# The agent reads the shared instructions and skills but can't rewrite
# them for the next session.
[ "$(verdict write "$HOME/.agents")" = DENIED ] || fail "the agent may write $HOME/.agents"

# jj and Maven still read their config, the hooks run agent-state, and
# the agent reads the shared instructions and skills.
for path in "$XDG_CONFIG_HOME/jj/repos" "$HOME/.m2/settings.xml" \
  "$HOME/.local/libexec/agents" "$HOME/.agents"; do
  [ "$(verdict read "$path")" = ALLOWED ] || fail "the agent may not read $path"
done

# A direct LaunchServices open starts an app outside the sandbox. sb grants
# it per launch through SB_ALLOW_LAUNCH_SERVICES. nono takes the flag only
# when the profile opts in, and the opt-in alone must grant nothing. The
# run with the flag proves that the log line is still the one to look for.
launch_services() {
  nono run --dry-run -vv --profile claude --allow "$tmp/work" "$@" -- true 2>&1 |
    grep -c -- '--allow-launch-services enabled' || true
}
[ "$(launch_services --allow-launch-services)" = 1 ] ||
  fail "the claude profile refuses --allow-launch-services"
[ "$(launch_services)" = 0 ] ||
  fail "the claude profile grants LaunchServices without the flag"
echo "nono ok"
