#!/usr/bin/env bash
#MISE description="Check that a failed cask warns and a failed formula fails"
set -eu
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-packages.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "$1" >&2
  exit 1
}

# Stubs make the installer take the macOS path. `brew bundle check`
# reports every list incomplete, and brew fails on the list whose file
# name matches BREW_FAIL.
mkdir "$tmp/bin"
printf '#!/bin/sh\necho Darwin\n' >"$tmp/bin/uname"
cat >"$tmp/bin/brew" <<'EOF'
#!/bin/sh
echo "$*" >>"$BREW_LOG"
case "$*" in "bundle check"* | *"$BREW_FAIL"*) exit 1 ;; esac
EOF
chmod +x "$tmp/bin"/*
export PATH="$tmp/bin:$PATH" BREW_LOG="$tmp/brew.log" CI=false DOTFILES_PACKAGES="core desktop"
export BREW_FAIL=desktop.casks

setup/packages/install 2>/dev/null || fail "a cask failure failed the install"
grep -q core "$BREW_LOG" || fail "selected core list skipped"
! grep -q agents "$BREW_LOG" || fail "unselected agents list installed"

# A failed formula fails the install, even in a list that also holds a
# cask.
! BREW_FAIL=core.formulae setup/packages/install 2>/dev/null ||
  fail "a formula failure passed"
echo "packages ok"
