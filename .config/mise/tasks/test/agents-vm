#!/usr/bin/env bash
#MISE description="Check how agents vm starts its proxy and copies the repository into the VM"
set -eu
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-agents-vm.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
script=$PWD/modules/agents/.local/libexec/agents/lima-agent

fail() {
  echo "$1" >&2
  exit 1
}

# Stubs that log every argument list to $ARGV_LOG. Like Lima, limactl
# quotes the guest command for sh and hands it to fish, the guest's login
# shell, which reads `\\` in single quotes as `\`. nono keeps the proxy
# password in $tmp/pass and serves until killed. sudo only logs. jq passes
# through to the real one. ssh runs its remote command locally. fish, the
# session, exits at once.
mkdir -p "$tmp/bin" "$tmp/home"
# mise shims would read the repo's mise config under the test's HOME, so
# PATH leaves them out.
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v /mise/shims | paste -sd: -)
real_jq=$(command -v jq)
cat >"$tmp/bin/limactl" <<'EOF'
#!/bin/sh
echo "limactl $*" >>"$ARGV_LOG"
case " $* " in *" -- "*) ;; *) exit 0 ;; esac
while [ "$1" != -- ]; do shift; done
shift
cmd=exec
for arg; do
  cmd="$cmd '$(printf '%s' "$arg" | sed "s/'/'\"'\"'/g")'"
done
exec fish --no-config -c "$cmd"
EOF
cat >"$tmp/bin/nono" <<'EOF'
#!/bin/sh
echo "nono $*" >>"$ARGV_LOG"
printf '%s' "$NONO_PROXY_PASS" >"$(dirname "$0")/../pass"
echo "  nono proxy listening on 127.0.0.1:4242"
exec sleep 60
EOF
cat >"$tmp/bin/sudo" <<'EOF'
#!/bin/sh
echo "sudo $*" >>"$ARGV_LOG"
EOF
cat >"$tmp/bin/jq" <<EOF
#!/bin/sh
echo "jq \$*" >>"\$ARGV_LOG"
exec "$real_jq" "\$@"
EOF
cat >"$tmp/bin/ssh" <<'EOF'
#!/bin/sh
for last; do :; done
exec sh -c "$last"
EOF
cat >"$tmp/bin/fish" <<EOF
#!/bin/sh
case "\$1" in -l) exit 0 ;; esac
exec "$(command -v fish)" "\$@"
EOF
chmod +x "$tmp/bin/"*
printf '[user]\n\tname = Test\n\temail = test@example.com\n' >"$tmp/gitconfig"

export HOME="$tmp/home" XDG_STATE_HOME="$tmp/state" PATH="$tmp/bin:$PATH" \
  ARGV_LOG="$tmp/argv.log" \
  GIT_CONFIG_GLOBAL="$tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1
# A launch copies the working tree of a repository without commits, at a
# path with a space, to the guest ref. Host and guest share the repository
# here, so the stale ref from a previous copy sits in the same place.
repo="$tmp/my repo"
git init -q "$repo"
stale=$(git -C "$repo" commit-tree -m stale "$(git -C "$repo" mktree </dev/null)")
git -C "$repo" update-ref refs/lima/host "$stale"
git -C "$repo" update-ref refs/lima/base "$stale"
echo a >"$repo/a"
(cd "$repo" && echo k | "$script" shell >/dev/null 2>&1) || fail "the launch failed"
[ "$(git -C "$repo" ls-tree --name-only refs/lima/host 2>/dev/null)" = a ] || fail "the guest ref lacks the working tree"

# The launch trusts the CA in the guest, removes the password file, and
# passes the password through no argument list.
grep -q "^sudo update-ca-trust" "$ARGV_LOG" || fail "the guest did not trust the CA"
[ ! -e "$HOME/.local/state/lima-agent/proxy-4242" ] || fail "the password file stayed"
pass=$(cat "$tmp/pass")
[ -n "$pass" ] || fail "the proxy got no password"
! grep -q "$pass" "$ARGV_LOG" || fail "the password showed in an argument list: $(grep "$pass" "$ARGV_LOG")"
grep -q "^nono proxy -p lima --proxy" "$ARGV_LOG" || fail "the proxy added GitHub without --github"
echo "agents-vm ok"
