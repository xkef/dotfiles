#!/usr/bin/env bash
#MISE description="Check the profile, settings, and environment sb passes to nono"
set -eu
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-sb.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "$1" >&2
  exit 1
}

# A stub nono records its arguments and the tokens it received.
mkdir -p "$tmp/bin" "$tmp/home/.claude"
cat >"$tmp/bin/nono" <<'EOF'
#!/bin/sh
printf '%s\n' "$@" >"$NONO_LOG"
echo "GH_TOKEN=${GH_TOKEN:-}" >>"$NONO_LOG"
echo "MISE_GITHUB_TOKEN=${MISE_GITHUB_TOKEN:-}" >>"$NONO_LOG"
echo "NPM_CONFIG_TOKEN=${npm_config_token:-}" >>"$NONO_LOG"
echo "SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-}" >>"$NONO_LOG"
echo "MAX_THINKING_TOKENS=${MAX_THINKING_TOKENS:-}" >>"$NONO_LOG"
echo "CLAUDE_CODE_OAUTH_TOKEN=${CLAUDE_CODE_OAUTH_TOKEN:-}" >>"$NONO_LOG"
EOF
chmod +x "$tmp/bin/nono"
cp modules/agents/.claude/settings.dotfiles.json "$tmp/home/.claude/settings.dotfiles.json"
# PATH holds only the stub and the tools the test needs, so sb skips the
# real agent-skills and agent-trace.
PATH="$tmp/bin:$(dirname "$(command -v fish)"):$(dirname "$(command -v jq)"):/usr/bin:/bin"
export PATH HOME="$tmp/home" NONO_LOG="$tmp/nono.log" GH_TOKEN=secret \
  MISE_GITHUB_TOKEN=secret npm_config_token=secret SSH_AUTH_SOCK=/agent.sock \
  MAX_THINKING_TOKENS=1 CLAUDE_CODE_OAUTH_TOKEN=login

sb() {
  fish --no-config -c "source modules/agents/.config/fish/functions/sb.fish; sb $*" 2>/dev/null
}

# The repo settings reach Claude Code with its own sandbox off.
sb claude
grep -qx claude "$NONO_LOG" || fail "wrong profile: $(cat "$NONO_LOG")"
settings=$(grep -A1 -x -- --settings "$NONO_LOG" | tail -1)
[ "$(jq -c .sandbox.enabled <<<"$settings")" = false ] || fail "sandbox not off"
[ "$(jq -c .hooks.Stop <<<"$settings")" != null ] || fail "repo settings missing"
grep -qx GH_TOKEN=secret "$NONO_LOG" || fail "default launch dropped GH_TOKEN"

sb --strict claude
grep -qx claude-strict "$NONO_LOG" || fail "strict used profile: $(cat "$NONO_LOG")"
for var in GH_TOKEN MISE_GITHUB_TOKEN NPM_CONFIG_TOKEN SSH_AUTH_SOCK; do
  grep -qx "$var=" "$NONO_LOG" || fail "strict launch kept $var"
done
grep -qx MAX_THINKING_TOKENS=1 "$NONO_LOG" || fail "strict launch dropped a setting"
grep -qx CLAUDE_CODE_OAUTH_TOKEN=login "$NONO_LOG" || fail "strict launch dropped the agent login"

# In the Lima VM, which is the sandbox, Claude Code runs without nono, its
# own sandbox, or permission prompts.
cat >"$tmp/bin/claude" <<'EOF'
#!/bin/sh
printf '%s\n' "$@" >"$CLAUDE_LOG"
EOF
chmod +x "$tmp/bin/claude"
export CLAUDE_LOG="$tmp/claude.log"
rm "$NONO_LOG"
fish --no-config -c "source modules/agents/.config/fish/functions/sb.fish
  function __sb_in_vm; true; end
  sb claude" 2>/dev/null
[ ! -e "$NONO_LOG" ] || fail "VM launch ran nono"
grep -qx -- --dangerously-skip-permissions "$CLAUDE_LOG" || fail "VM launch kept permission prompts"
settings=$(grep -A1 -x -- --settings "$CLAUDE_LOG" | tail -1)
[ "$(jq -c .sandbox.enabled <<<"$settings")" = false ] || fail "VM launch kept Claude Code's sandbox"
echo "sb ok"
