#!/usr/bin/env bash
#MISE description="Probe what each nono profile lets an agent read, write, see, and reach"
# Runs a probe as the agent through sb and nono in a decoy HOME. Skips
# without nono. The fixture must be outside /tmp and $TMPDIR
# (SANDBOX_TEST_ROOT). SANDBOX_TEST_NETWORK=1 adds network checks.
# Known gap: .git/config in the workdir stays writable.
set -eu

if ! command -v nono >/dev/null; then
  echo "sandbox: nono not installed, skipped"
  exit 0
fi

repo=$PWD
base=${SANDBOX_TEST_ROOT:-${RUNNER_TEMP:-$HOME}}
root=$(mktemp -d "$base/sandbox-test.XXXXXX")
trap 'chmod -R u+w "$root"; rm -rf "$root"' EXIT

export HOME=$root/home
export XDG_CONFIG_HOME=$HOME/.config XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state XDG_CACHE_HOME=$HOME/.cache
export DOTFILES_DIR=$root/dotfiles
H=$HOME C=$XDG_CONFIG_HOME D=$XDG_DATA_HOME P=$root/project O=$root/outside

# Decoy files and granted directories.
files=(
  "$P/file" "$P/.git/config" "$DOTFILES_DIR/README.md" "$O/canary"
  "$H/.ssh/id_ed25519" "$H/.aws/credentials" "$C/gh/hosts.yml" "$C/op/config"
  "$H/.bash_history" "$C/fish/config.fish" "$C/git/config" "$C/jj/config.toml"
  "$H/.agents/skills/probe/notes.txt" "$H/.claude/settings.json" "$H/.claude.json"
  "$H/.pi/agent/settings.json" "$D/cargo/bin/tool" "$D/cargo/.package-cache"
  "$D/mise/installs/node/bin/node" "$D/uv/python/bin/python" "$D/go/bin/tool"
  "$D/rustup/toolchains/stable/bin/rustc" "$H/.m2/settings.xml"
  "$H/Library/Keychains/login.keychain-db" "$C/nono/profiles/.keep"
)
dirs=(
  "$D/cargo/registry" "$D/cargo/git" "$D/go/pkg/mod" "$H/.m2/repository"
  "$H/.npm" "$H/.cache/mise" "$H/.local/bin" "$H/.local/state/agents"
)
for f in "${files[@]}"; do
  mkdir -p "$(dirname "$f")"
  echo decoy >"$f"
done
mkdir -p "${dirs[@]}"
cp "$repo"/modules/agents/.config/nono/profiles/*.json "$C/nono/profiles/"
cp "$repo/modules/agents/.claude/settings.dotfiles.json" "$H/.claude/"

# Stands in for claude and pi; checks follow --probe.
cat >"$H/.local/bin/claude" <<'EOF'
#!/bin/sh
while [ $# -gt 0 ] && [ "$1" != --probe ]; do shift; done
shift
for c; do
  arg=${c#*:}
  case $c in
  r:*) if [ -d "$arg" ]; then ls "$arg"; else cat "$arg"; fi ;;
  w:*) if [ -d "$arg" ]; then
    (: >"$arg/.probe") && { rm -f "$arg/.probe"; true; }
  else (: >>"$arg"); fi ;;
  e:*) printenv "$arg" ;;
  v:*) [ "$(printenv "${arg%%=*}")" = "${arg#*=}" ] ;;
  n:*) curl -fsS -o /dev/null --max-time 20 "$arg" ;;
  esac >/dev/null 2>&1 && r=yes || r=no
  echo "$c $r"
done
EOF
chmod +x "$H/.local/bin/claude"
cp "$H/.local/bin/claude" "$H/.local/bin/pi"

# Stub op returns fake tokens.
mkdir -p "$root/bin"
cat >"$root/bin/op" <<'EOF'
#!/bin/sh
case "$3" in
*"GitHub agents"*) echo gh-agent-token ;;
*"Claude Code"*) echo claude-token ;;
*) exit 1 ;;
esac
EOF
chmod +x "$root/bin/op"

tool_dirs=
for t in nono fish jq curl; do
  tool_dirs=$tool_dirs:$(dirname "$(command -v "$t")")
done
export PATH="$root/bin:$H/.local/bin$tool_dirs:/usr/bin:/bin:/usr/sbin:/sbin"
# Host environment.
export GH_TOKEN=host-gh-token GITHUB_TOKEN=host-gh-token MISE_GITHUB_TOKEN=public
export AWS_SECRET_ACCESS_KEY=decoy SSH_AUTH_SOCK=$root/agent.sock
export CLAUDE_CODE_OAUTH_TOKEN=host-claude-token

# Columns: claude, claude-strict, pi. "-" skips; "mac:"/"linux:" limits OS.
expected="
r:$P/file                            yes yes yes
w:$P/file                            yes yes yes
w:$P/.git/config                     yes yes yes
r:$DOTFILES_DIR/README.md            yes yes yes
w:$DOTFILES_DIR/README.md            no  no  no
r:$O/canary                          no  no  no
w:$O                                 no  no  no
r:$H/.ssh/id_ed25519                 no  no  no
r:$H/.aws/credentials                no  no  no
r:$C/gh/hosts.yml                    no  no  no
r:$C/op/config                       no  no  no
r:$H/.bash_history                   no  no  no
r:$C/fish/config.fish                no  no  no
r:$C/git/config                      yes yes yes
w:$C/git/config                      no  no  no
r:$C/jj/config.toml                  yes yes yes
w:$C/jj/config.toml                  no  no  no
w:$C/jj                              no  no  no
r:$H/.agents/skills/probe/notes.txt  yes yes yes
w:$H/.agents/skills                  no  no  no
w:$H/.claude                         yes yes no
w:$H/.claude.json                    yes yes no
w:$H/.pi/agent                       no  no  yes
w:$C/nono/profiles                   no  no  no
r:$H/.local/bin/claude               yes yes yes
w:$H/.local/bin                      no  no  no
w:$H/.local/state/agents             yes yes yes
r:$D/cargo/bin/tool                  yes yes yes
w:$D/cargo/bin/tool                  no  no  no
w:$D/cargo/registry                  yes yes yes
w:$D/cargo/git                       yes yes yes
w:$D/cargo/.package-cache            yes yes yes
w:$D/rustup/toolchains               no  no  no
r:$D/mise/installs/node/bin/node     yes yes yes
w:$D/mise/installs                   no  no  no
w:$D/uv/python                       no  no  no
w:$D/go/bin                          no  no  no
w:$D/go/pkg/mod                      yes yes yes
r:$H/.m2/settings.xml                yes yes yes
w:$H/.m2/settings.xml                no  no  no
w:$H/.m2/repository                  yes yes yes
w:$H/.npm                            yes yes yes
w:$H/.cache/mise                     yes yes yes
mac:r:$H/Library/Keychains/login.keychain-db yes no yes
v:GH_TOKEN=gh-agent-token            yes no  yes
e:GH_TOKEN                           yes no  yes
e:GITHUB_TOKEN                       no  no  no
v:MISE_GITHUB_TOKEN=public           yes no  yes
e:AWS_SECRET_ACCESS_KEY              no  no  no
v:CLAUDE_CODE_OAUTH_TOKEN=claude-token no yes no
e:SSH_AUTH_SOCK                      yes no  yes
"
if [ "${SANDBOX_TEST_NETWORK:-}" = 1 ]; then
  expected="$expected
n:https://github.com                 yes yes yes
n:https://example.com                yes no  yes
"
fi

case $(uname -s) in
Darwin) os=mac ;;
*) os=linux ;;
esac

failures=0
run() {
  local col=$1
  shift
  local checks=() want=()
  while read -r check a b c; do
    [ -n "$check" ] || continue
    case $check in
    mac:* | linux:*)
      [ "${check%%:*}" = "$os" ] || continue
      check=${check#*:}
      ;;
    esac
    local w
    case $col in 1) w=$a ;; 2) w=$b ;; 3) w=$c ;; esac
    [ "$w" = - ] && continue
    checks+=("$check")
    want+=("$w")
  done <<<"$expected"

  local out
  out=$(cd "$P" && fish --no-config -c \
    "source $repo/modules/agents/.config/fish/functions/sb.fish; sb $* \$argv" \
    -- --probe "${checks[@]}" 2>"$root/stderr") || true
  if [ -z "$out" ]; then
    echo "FAIL sb $*: no probe output" >&2
    cat "$root/stderr" >&2
    failures=$((failures + 1))
    return
  fi
  local i got
  for i in "${!checks[@]}"; do
    got=$(grep -F -x -e "${checks[$i]} yes" -e "${checks[$i]} no" <<<"$out" | awk '{print $NF}')
    if [ "$got" != "${want[$i]}" ]; then
      echo "FAIL sb $*: ${checks[$i]#*:} (${checks[$i]%%:*}) expected ${want[$i]}, got ${got:-nothing}" >&2
      failures=$((failures + 1))
    fi
  done
  echo "sb $*: ${#checks[@]} checks"
}

run 1 claude
run 2 --strict claude
run 3 pi

if [ "$failures" -gt 0 ]; then
  echo "sandbox: $failures failed checks" >&2
  exit 1
fi
echo "sandbox ok"
