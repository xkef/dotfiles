#!/usr/bin/env bash
#MISE description="Check that setup/deploy rejects a dotter download that fails the lock"
set -eu
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-deploy.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "$1" >&2
  exit 1
}

# A stub curl writes a binary that can't match the locked checksum, and a
# stub systemd-detect-virt reports bare metal. The system dirs supply the
# rest, so a dotter there would skip the download.
mkdir -p "$tmp/bin"
cat >"$tmp/bin/curl" <<'EOF'
#!/bin/sh
while [ "$1" != -o ]; do shift; done
echo tampered >"$2"
EOF
printf '#!/bin/sh\nexit 1\n' >"$tmp/bin/systemd-detect-virt"
chmod +x "$tmp/bin"/*
path="$tmp/bin:/usr/bin:/bin"
if PATH=$path command -v dotter >/dev/null; then
  echo "deploy skipped: dotter in the system path"
  exit 0
fi

if env PATH="$path" XDG_STATE_HOME="$tmp/state" HOME="$tmp/home" setup/deploy 2>/dev/null; then
  fail "deploy ran a dotter that fails the checksum"
fi
[ ! -e "$tmp/state/dotter/dotter" ] || fail "deploy kept the tampered dotter"
echo "deploy ok"
