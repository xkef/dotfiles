#!/usr/bin/env bash
#MISE description="Deploy the repo into a throwaway HOME and assert results"
set -eu
# macOS mktemp ignores TMPDIR without a template.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/check.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/home"
printf 'packages = ["core", "desktop", "agents", "wezterm", "helix", "zed", "kickstart"]\n' >"$tmp/local.toml"

# Hook paths that don't exist skip the hooks, which install packages and
# change the login shell.
HOME="$tmp/home" dotter --global-config setup/dotter/global.toml \
  --local-config "$tmp/local.toml" \
  --cache-file "$tmp/cache.toml" --cache-directory "$tmp/cache" \
  --pre-deploy none --post-deploy none --noconfirm --quiet deploy

broken=$(find "$tmp/home" -type l ! -exec test -e {} \; -print)
if [ -n "$broken" ]; then
  echo "broken links:"
  echo "$broken"
  exit 1
fi

# Dotter links every file in a package, ignored ones too, so a log or a
# cache left in modules/ lands in $HOME. Finder's .DS_Store is harmless.
stray=$(git ls-files --others --ignored --exclude-standard -- 'modules/*/*' ':!:*.DS_Store')
if [ -n "$stray" ]; then
  echo "ignored files in a package:"
  echo "$stray"
  exit 1
fi

if command -v fish >/dev/null; then
  for f in "$tmp"/home/.config/fish/conf.d/*.fish "$tmp"/home/.config/fish/functions/*.fish; do
    fish --no-execute "$f"
  done
fi
echo "dotter smoke ok"
