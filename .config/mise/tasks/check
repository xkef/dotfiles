#!/usr/bin/env bash
#MISE description="Deploy the repo into a throwaway HOME and assert results"
set -eu
# macOS mktemp ignores TMPDIR without a template.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/check.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/home"
printf 'packages = ["core", "desktop", "agents"]\n' >"$tmp/local.toml"

# Hook paths that don't exist skip the hooks, which install packages and
# change the login shell.
HOME="$tmp/home" dotter --global-config setup/dotter/global.toml \
  --local-config "$tmp/local.toml" \
  --cache-file "$tmp/cache.toml" --cache-directory "$tmp/cache" \
  --pre-deploy none --post-deploy none --noconfirm --quiet deploy

broken=$(find "$tmp/home" -type l ! -exec test -e {} \; -print)
if [ -n "$broken" ]; then
  echo "broken links:"
  echo "$broken"
  exit 1
fi

# Without op or an identity file, render writes nothing. With a file,
# render writes the identity from it.
render() {
  env PATH=/usr/bin:/bin HOME="$tmp/home" XDG_CONFIG_HOME="$tmp/home/.config" \
    setup/identity/render
}
render
test ! -e "$tmp/home/.config/git/config.personal" || {
  echo "unexpected config.personal"
  exit 1
}
mkdir -p "$tmp/home/.config/identity"
printf 'name=Ada\nemail=ada@example.com\npublic_key=ssh-ed25519 AAAA\n' \
  >"$tmp/home/.config/identity/Personal"
render
grep -qxF 'email = "ada@example.com"' "$tmp/home/.config/jj/conf.d/identity.toml" || {
  echo "identity file not rendered"
  exit 1
}

# With a github_login, Work also renders a secondary identity.
printf 'name=Ada\nemail=ada@work.example\nnoreply_email=1+ada@users.noreply.github.com\ngithub_login=ada\npublic_key=ssh-ed25519 BBBB\n' \
  >"$tmp/home/.config/identity/Work"
render
test -e "$tmp/home/.config/git/config.work" || {
  echo "work identity not rendered"
  exit 1
}
test -e "$tmp/home/.config/git/config.secondary-remotes" || {
  echo "github_login rendered no secondary identity"
  exit 1
}

# Without github_login, Work renders the same fields as Personal and no
# secondary identity.
printf 'name=Ada\nemail=ada@work.example\npublic_key=ssh-ed25519 BBBB\n' \
  >"$tmp/home/.config/identity/Work"
render
test -e "$tmp/home/.config/git/config.work" &&
  test ! -e "$tmp/home/.config/git/config.secondary-remotes" || {
  echo "work without github_login rendered wrong"
  exit 1
}
# The no-work marker skips the Work identity and removes its files.
touch "$tmp/home/.config/identity/no-work"
render
for f in git/config.work git/config.secondary git/config.secondary-remotes jj/conf.d/work.toml; do
  test ! -e "$tmp/home/.config/$f" || {
    echo "no-work left $f"
    exit 1
  }
done
! grep -q BBBB "$tmp/home/.config/git/allowed_signers" || {
  echo "no-work left the work signer"
  exit 1
}

if command -v fish >/dev/null; then
  for f in "$tmp"/home/.config/fish/conf.d/*.fish "$tmp"/home/.config/fish/functions/*.fish; do
    fish --no-execute "$f"
  done
fi
echo "dotter smoke ok"
