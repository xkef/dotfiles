#!/usr/bin/env bash
#MISE description="Link each module selection into a throwaway HOME and assert results"
set -eu
# macOS mktemp ignores TMPDIR without a template.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/check.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# Each selection links on its own, since a file in one module can link
# or source into another that a machine leaves out.
selections=(
  'core'
  'core agents'
  'core desktop'
  'core wezterm'
  'core helix'
  'core desktop agents'
  'core desktop agents wezterm helix zed kickstart'
)
for selection in "${selections[@]}"; do
  run=$(mktemp -d "$tmp/run.XXXXXX")
  mkdir -p "$run/home"
  # shellcheck disable=SC2086 # The selection splits into modules.
  HOME="$run/home" setup/link "$run/state" $selection >/dev/null

  broken=$(find "$run/home" -type l ! -exec test -e {} \; -print)
  if [ -n "$broken" ]; then
    echo "broken links with [$selection]:"
    echo "$broken"
    exit 1
  fi

  if command -v fish >/dev/null; then
    for f in "$run"/home/.config/fish/conf.d/*.fish "$run"/home/.config/fish/functions/*.fish; do
      fish --no-execute "$f"
    done
  fi
done

# setup/link links every file in a module, ignored ones too, so a log or a
# cache left in modules/ lands in $HOME. Finder's .DS_Store is harmless.
stray=$(git ls-files --others --ignored --exclude-standard -- 'modules/*/*' ':!:*.DS_Store')
if [ -n "$stray" ]; then
  echo "ignored files in a package:"
  echo "$stray"
  exit 1
fi

echo "link smoke ok"
