#!/usr/bin/env bash
#MISE description="Format all dotfiles"
set -eu

stylua modules/
git ls-files -z | xargs -0 shfmt -f | xargs shfmt -w
# Scripts without a .fish extension count through their shebang.
{ git ls-files '*.fish' && git grep -l '^#!/usr/bin/env fish' -- modules; } | xargs fish_indent -w
dprint fmt --config .config/dprint.json
git ls-files -z '*.toml' | xargs -0 taplo fmt
