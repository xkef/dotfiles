#!/usr/bin/env bash
#MISE description="Check the formatting that mise run fmt writes"
set -eu
stylua --check modules/
git ls-files -z | xargs -0 shfmt -f | xargs shfmt -d
# Scripts without a .fish extension count through their shebang.
{ git ls-files '*.fish' && git grep -l '^#!/usr/bin/env fish' -- modules; } | xargs fish_indent --check
dprint check --config .config/dprint.json
git ls-files -z '*.toml' | xargs -0 taplo fmt --check
