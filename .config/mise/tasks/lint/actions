#!/usr/bin/env bash
#MISE description="Audit the GitHub workflows with zizmor"
set -eu

# zizmor rejects an empty token, which agent sandboxes set. Without a
# token it skips the audits that query GitHub.
for var in GH_TOKEN GITHUB_TOKEN ZIZMOR_GITHUB_TOKEN; do
  [ -n "${!var:-}" ] || unset "$var"
done

# The agent sandbox points ZIZMOR_CACHE_DIR at a cache it may write, since
# zizmor has no environment variable for its cache.
zizmor ${ZIZMOR_CACHE_DIR:+--cache-dir "$ZIZMOR_CACHE_DIR"} .
