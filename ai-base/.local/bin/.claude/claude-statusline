#!/bin/bash
# Single-line Claude Code status line:
#   5h 17% (33m) · 7d 60% (11h 33m) · 12% ctx · Opus 4.8 · $4.58 · +142 -35 · ~/dotfiles
#
# The 5h (session) and 7d (all-models weekly) quota segments come from
# rate_limits.*, which Claude Code sends only to Pro/Max sessions after the
# first API response; each window can be independently absent, in which case
# that segment is simply skipped. Per-model weekly limits (the Opus/Fable line
# in /usage) are NOT exposed to status lines and cannot be shown here.

input=$(cat)

eval "$(echo "$input" | jq -r '
  @sh "MODEL=\(.model.display_name)",
  @sh "PCT=\(.context_window.used_percentage // 0 | floor)",
  @sh "COST=\(.cost.total_cost_usd // 0)",
  @sh "ADDED=\(.cost.total_lines_added // 0)",
  @sh "REMOVED=\(.cost.total_lines_removed // 0)",
  @sh "CWD=\(.cwd)",
  @sh "RL5=\(.rate_limits.five_hour.used_percentage // -1 | floor)",
  @sh "RL5_RESET=\(.rate_limits.five_hour.resets_at // 0 | floor)",
  @sh "RL7=\(.rate_limits.seven_day.used_percentage // -1 | floor)",
  @sh "RL7_RESET=\(.rate_limits.seven_day.resets_at // 0 | floor)"
')"

CYAN='\033[36m'; YELLOW='\033[33m'; RED='\033[31m'; GREEN='\033[32m'; DIM='\033[2m'; RESET='\033[0m'
NOW=$(date +%s)

pct_color() {  # low=green, high=red — high quota use and high ctx both read as "hot"
  if [ "$1" -ge 80 ]; then printf '%s' "$RED"
  elif [ "$1" -ge 50 ]; then printf '%s' "$YELLOW"
  else printf '%s' "$GREEN"; fi
}

human_eta() {  # seconds -> "33m" / "11h 33m"
  local s=$1
  (( s <= 0 )) && { printf 'now'; return; }
  local h=$((s / 3600)) m=$(((s % 3600) / 60))
  (( h > 0 )) && printf '%dh %dm' "$h" "$m" || printf '%dm' "$m"
}

quota_seg() {  # $1=pct $2=reset_epoch $3=label -> "5h 17% (33m)"
  printf '%b%s %d%%%b %b(%s)%b' \
    "$(pct_color "$1")" "$3" "$1" "$RESET" \
    "$DIM" "$(human_eta $(( $2 - NOW )))" "$RESET"
}

QUOTA=""
[ "$RL5" -ge 0 ] && QUOTA="$QUOTA$(quota_seg "$RL5" "$RL5_RESET" 5h) ${DIM}·${RESET} "
[ "$RL7" -ge 0 ] && QUOTA="$QUOTA$(quota_seg "$RL7" "$RL7_RESET" 7d) ${DIM}·${RESET} "

COST_FMT=$(printf '$%.2f' "$COST")
LINES=""
if [ "$ADDED" -gt 0 ] || [ "$REMOVED" -gt 0 ]; then
  LINES=" ${DIM}·${RESET} ${GREEN}+${ADDED}${RESET} ${RED}-${REMOVED}${RESET}"
fi
DIR="${CWD/#$HOME/~}"

printf '%b\n' "${QUOTA}$(pct_color "$PCT")${PCT}%${RESET} ctx ${DIM}·${RESET} ${MODEL} ${DIM}·${RESET} ${COST_FMT}${LINES} ${DIM}·${RESET} ${DIM}${DIR}${RESET}"
