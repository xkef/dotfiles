{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise run lint*)",
      "Bash(mise run test*)",
      "Bash(mise run check)",
      "Bash(mise run fmt)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git stash *)"
    ]
  }
}
