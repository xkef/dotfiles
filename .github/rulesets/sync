#!/usr/bin/env bash
# Sync GitHub rulesets from the JSON files in this directory.
# Creates or updates each ruleset by name via the GitHub API.
set -euo pipefail

cd "$(dirname "$0")"
repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

for f in *.json; do
	name=$(jq -r .name "$f")
	id=$(gh api "repos/$repo/rulesets" \
		--jq ".[] | select(.name == \"$name\") | .id")
	if [ -n "$id" ]; then
		gh api -X PUT "repos/$repo/rulesets/$id" --input "$f" >/dev/null
		echo "updated $name"
	else
		gh api -X POST "repos/$repo/rulesets" --input "$f" >/dev/null
		echo "created $name"
	fi
done
